<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderSuite.RenderQueue.ViewModels"
             xmlns:logVm="clr-namespace:BlenderSuite.RenderQueue.ViewModels.Logs"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderSuite.RenderQueue.Localizer"
             mc:Ignorable="d"
             x:Class="BlenderSuite.RenderQueue.Views.GlobalLogView"
             x:DataType="vm:GlobalLogViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Margin="10">
        <Grid.Styles>
            <Style Selector="TextBox.GlobalLogSearchBox">
                <Setter Property="Width" Value="330" />
                <Setter Property="MinWidth" Value="260" />
                <Setter Property="Margin" Value="0 0 8 8" />
            </Style>
            <Style Selector="ComboBox.GlobalLogFilterBox">
                <Setter Property="MinWidth" Value="154" />
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="Margin" Value="0 0 8 8" />
            </Style>
        </Grid.Styles>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{i18n:Localize GlobalLog_Title}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding RefreshEntriesCommand}"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Classes="Basic Icon"
                        ToolTip.Tip="{i18n:Localize Queue_Refresh}">
                    <avalonia:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
                <Button Content="{i18n:Localize GlobalLog_ClearHistory}"
                        Command="{Binding ClearHistoryCommand}"
                        Classes="Flat Rounded"
                        IsVisible="{Binding HasHistoricalEntries}" />
                <Button Content="{i18n:Localize GlobalLog_ClearAll}"
                        Command="{Binding ClearAllCommand}"
                        Classes="Flat Rounded" />
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1"
                   Orientation="Horizontal">
            <TextBox PlaceholderText="{i18n:Localize GlobalLog_Search}"
                     Text="{Binding SearchText}"
                     Classes="GlobalLogSearchBox" />
            <ComboBox ItemsSource="{Binding AudienceOptions}"
                      SelectedItem="{Binding SelectedAudience}"
                      Width="156"
                      Classes="GlobalLogFilterBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding LevelOptions}"
                      SelectedItem="{Binding SelectedLevel}"
                      Width="196"
                      Classes="GlobalLogFilterBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding ScopeOptions}"
                      SelectedItem="{Binding SelectedScope}"
                      Width="156"
                      Classes="GlobalLogFilterBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding SessionOptions}"
                      SelectedItem="{Binding SelectedSession}"
                      Width="156"
                      Classes="GlobalLogFilterBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding TaskOptions}"
                      SelectedItem="{Binding SelectedTask}"
                      Width="220"
                      Classes="GlobalLogFilterBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalLogViewModel+TaskFilterOption">
                        <TextBlock Text="{Binding DisplayLabel}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </WrapPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding FilterSummaryText}"
                   FontSize="12"
                   Opacity="0.62"
                   Margin="2 0 0 0" />

        <Border Grid.Row="3" Padding="0 4 0 0">
            <Grid>
                <TextBlock Text="{i18n:Localize GlobalLog_NoEntries}"
                           IsVisible="{Binding !HasEntries}"
                           Opacity="0.7"
                           Margin="8" />

                <ListBox
                        IsVisible="{Binding HasEntries}"
                        ItemsSource="{Binding Entries}"
                        Classes="Void Stack BrqInteractiveList"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Margin" Value="0 0 0 4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="Border.LogEntrySurface">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Border.LogEntrySurface:pointerover">
                            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border.LogEntrySurface">
                            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected Border.LogEntrySurface">
                            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover Border.LogEntrySurface">
                            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
                        </Style>
                        <Style Selector="Border.LogEntryTag">
                            <Setter Property="CornerRadius" Value="7" />
                            <Setter Property="Padding" Value="7,2" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </Style>
                        <Style Selector="TextBlock.LogEntryTagText">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="logVm:GlobalLogEntryViewModel">
                            <Border Padding="12,9"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    BorderThickness="1"
                                    Classes="LogEntrySurface">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding TimeText}"
                                                         FontWeight="SemiBold"
                                                         FontSize="12"
                                                         VerticalAlignment="Top"
                                                         Margin="0 2 0 0"
                                                         Opacity="0.82" />

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Message}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       VerticalAlignment="Top" />

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Right">
                                                <SelectableTextBlock Text="{Binding TaskText}"
                                                                     IsVisible="{Binding HasTask}"
                                                                     Opacity="0.62"
                                                                     FontSize="12"
                                                                     VerticalAlignment="Center" />
                                                <Border Background="#283B5E" Classes="LogEntryTag">
                                                    <TextBlock Text="{Binding ScopeText}" Classes="LogEntryTagText" />
                                                </Border>
                                                <Border Background="#3B3224" Classes="LogEntryTag">
                                                    <TextBlock Text="{Binding LevelText}" Classes="LogEntryTagText" />
                                                </Border>
                                                <Border Background="#3A2934"
                                                        Classes="LogEntryTag"
                                                        IsVisible="{Binding ShowAudienceBadge}">
                                                    <TextBlock Text="{Binding AudienceText}" Classes="LogEntryTagText" />
                                                </Border>
                                                <Border Background="#29313A"
                                                        Classes="LogEntryTag"
                                                        IsVisible="{Binding ShowSessionBadge}">
                                                    <TextBlock Text="{Binding SessionText}" Classes="LogEntryTagText" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Expander Header="{Binding DetailsHeader}"
                                                  IsVisible="{Binding HasDetails}">
                                            <ItemsControl ItemsSource="{Binding Details}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="logVm:GlobalLogDetailEntryViewModel">
                                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                                              ColumnSpacing="8"
                                                              Margin="0 4 0 0">
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="11"
                                                                       Opacity="0.66" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LevelText}"
                                                                       FontSize="11"
                                                                       Opacity="0.66" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding PhaseText}"
                                                                       FontSize="11"
                                                                       Opacity="0.66" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Message}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11.5"
                                                                       Opacity="0.82" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                                Command="{Binding NavigateToTaskCommand}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Classes="Basic Icon"
                                            ToolTip.Tip="{i18n:Localize GlobalLog_OpenTask}"
                                            IsVisible="{Binding HasTask}">
                                        <avalonia:MaterialIcon Kind="OpenInNew" Width="17" Height="17" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
