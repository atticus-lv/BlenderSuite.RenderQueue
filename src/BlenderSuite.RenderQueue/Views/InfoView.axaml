<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderSuite.RenderQueue.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="BlenderSuite.RenderQueue.Views.InfoView"
             x:DataType="vm:MainRenderViewModel"
             d:DesignWidth="900"
             d:DesignHeight="720">

    <UserControl.Styles>
        <Style Selector="Button.InfoLinkButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="Button.InfoLinkButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.InfoLinkButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="32,28"
                    Spacing="26"
                    MaxWidth="980"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Blender Suite: Render Queue"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="版本信息与开源组件许可"
                           FontSize="14"
                           Opacity="0.68" />
            </StackPanel>

            <Border Height="1"
                    Background="{DynamicResource SukiBorderColor}" />

            <Grid ColumnDefinitions="220,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="12"
                  ColumnSpacing="24">
                <TextBlock Text="应用版本"
                           Opacity="0.66" />
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding AppVersion}" />

                <TextBlock Grid.Row="1"
                           Text="作者"
                           Opacity="0.66" />
                <SelectableTextBlock Grid.Row="1"
                                     Grid.Column="1"
                                     Text="Atticus" />

                <TextBlock Grid.Row="2"
                           Text="版权"
                           Opacity="0.66" />
                <SelectableTextBlock Grid.Row="2"
                                     Grid.Column="1"
                                     Text="Atticus 2025" />

                <TextBlock Grid.Row="3"
                           Text="运行时"
                           Opacity="0.66" />
                <SelectableTextBlock Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding RuntimeDisplay}"
                                     TextWrapping="Wrap" />

                <TextBlock Grid.Row="4"
                           Text="操作系统"
                           Opacity="0.66" />
                <SelectableTextBlock Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding OperatingSystemDisplay}"
                                     TextWrapping="Wrap" />

                <TextBlock Grid.Row="5"
                           Text="源码仓库"
                           Opacity="0.66" />
                <Button Grid.Row="5"
                        Grid.Column="1"
                        Classes="InfoLinkButton"
                        Tag="https://github.com/atticus-lv/BlenderSuite.RenderQueue"
                        Click="OpenUrlButton_OnClick">
                    <TextBlock Text="https://github.com/atticus-lv/BlenderSuite.RenderQueue"
                               TextDecorations="Underline"
                               TextWrapping="Wrap" />
                </Button>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Text="项目许可"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="220,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="12"
                      ColumnSpacing="24">
                    <TextBlock Text="许可类型"
                               Opacity="0.66" />
                    <SelectableTextBlock Grid.Column="1"
                                         Text="AGPL-3.0-only（公共版本）；商业授权需单独协议"
                                         TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1"
                               Text="许可文件"
                               Opacity="0.66" />
                    <WrapPanel Grid.Row="1"
                               Grid.Column="1">
                        <Button Classes="InfoLinkButton"
                                Margin="0,0,8,6"
                                Tag="https://github.com/atticus-lv/BlenderSuite.RenderQueue/blob/main/LICENSE"
                                Click="OpenUrlButton_OnClick">
                            <TextBlock Text="LICENSE"
                                       TextDecorations="Underline" />
                        </Button>
                        <Button Classes="InfoLinkButton"
                                Margin="0,0,8,6"
                                Tag="https://github.com/atticus-lv/BlenderSuite.RenderQueue/blob/main/COMMERCIAL_LICENSE.md"
                                Click="OpenUrlButton_OnClick">
                            <TextBlock Text="COMMERCIAL_LICENSE.md"
                                       TextDecorations="Underline" />
                        </Button>
                        <Button Classes="InfoLinkButton"
                                Margin="0,0,8,6"
                                Tag="https://github.com/atticus-lv/BlenderSuite.RenderQueue/blob/main/Install/license_zh.txt"
                                Click="OpenUrlButton_OnClick">
                            <TextBlock Text="Install/license_zh.txt"
                                       TextDecorations="Underline" />
                        </Button>
                        <Button Classes="InfoLinkButton"
                                Margin="0,0,8,6"
                                Tag="https://github.com/atticus-lv/BlenderSuite.RenderQueue/blob/main/Install/license_en.txt"
                                Click="OpenUrlButton_OnClick">
                            <TextBlock Text="Install/license_en.txt"
                                       TextDecorations="Underline" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="开源组件"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,140"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="10"
                      ColumnSpacing="18">
                    <TextBlock Text="组件"
                               FontWeight="SemiBold"
                               Opacity="0.72" />
                    <TextBlock Grid.Column="1"
                               Text="许可"
                               FontWeight="SemiBold"
                               Opacity="0.72" />

                    <Button Grid.Row="1"
                            Classes="InfoLinkButton"
                            Tag="https://github.com/AvaloniaUI/Avalonia"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="Avalonia"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="1"
                                         Grid.Column="1"
                                         Text="MIT" />

                    <Button Grid.Row="2"
                            Classes="InfoLinkButton"
                            Tag="https://github.com/kikipoulet/SukiUI"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="SukiUI"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="2"
                                         Grid.Column="1"
                                         Text="MIT" />

                    <Button Grid.Row="3"
                            Classes="InfoLinkButton"
                            Tag="https://github.com/CommunityToolkit/dotnet"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="CommunityToolkit.Mvvm"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="3"
                                         Grid.Column="1"
                                         Text="MIT" />

                    <Button Grid.Row="4"
                            Classes="InfoLinkButton"
                            Tag="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="LibreHardwareMonitorLib"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="4"
                                         Grid.Column="1"
                                         Text="MPL-2.0" />

                    <Button Grid.Row="5"
                            Classes="InfoLinkButton"
                            Tag="https://www.nuget.org/packages/Material.Icons.Avalonia"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="Material.Icons.Avalonia"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="5"
                                         Grid.Column="1"
                                         Text="MIT" />

                    <Button Grid.Row="6"
                            Classes="InfoLinkButton"
                            Tag="https://github.com/dotnet/extensions"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="Microsoft.Extensions.DependencyInjection"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="6"
                                         Grid.Column="1"
                                         Text="MIT" />

                    <Button Grid.Row="7"
                            Classes="InfoLinkButton"
                            Tag="https://www.nuget.org/packages/Xaml.Behaviors.Interactivity"
                            Click="OpenUrlButton_OnClick">
                        <TextBlock Text="Xaml.Behaviors"
                                   TextDecorations="Underline" />
                    </Button>
                    <SelectableTextBlock Grid.Row="7"
                                         Grid.Column="1"
                                         Text="MIT" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
