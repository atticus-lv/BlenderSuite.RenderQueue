<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:services1="clr-namespace:BlenderRenderQueue.Services"
             xmlns:controls="clr-namespace:BlenderRenderQueue.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             xmlns:ui="clr-namespace:BlenderRenderQueue.Services.UI"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.MainRenderView"
             x:DataType="vm:MainRenderViewModel"
             ui:ToplevelService.Register="{Binding}">

    <Grid RowDefinitions="*,Auto" Margin="0 0 0 0">

        <!-- 主界面内容 -->
        <suki:SukiSideMenu x:Name="SideMenu"
                           Grid.Row="0"
                           IsSearchEnabled="False"
                           IsMenuExpanded="False">
            <suki:SukiSideMenu.Items>
                <!-- 渲染队列页面 -->
                <suki:SukiSideMenuItem x:Name="QueueMenuItem"
                                       Header="{i18n:Localize Queue_RenderQueue}"
                                       Classes="Compact"
                                       Tag="0"
                                       Tapped="OnNavigationMenuItemTapped">
                    <suki:SukiSideMenuItem.Icon>
                        <avalonia:MaterialIcon Kind="ListStatus" Width="24" Height="24" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid>
                            <views:RenderQueueView DataContext="{Binding RenderQueue}"
                                                   VerticalAlignment="Stretch"
                                                   Margin="0 4 0 0 "
                                                   HorizontalAlignment="Stretch"
                                                   IsVisible="{Binding $parent[UserControl].((vm:MainRenderViewModel)DataContext).IsBlenderPathValid}" />


                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding $parent[UserControl].((vm:MainRenderViewModel)DataContext).HasBlenderValidationError}"
                                        Spacing="16">
                                <avalonia:MaterialIcon Kind="Error"
                                                       Width="64"
                                                       Height="64"
                                                       Foreground="{DynamicResource SukiDangerColor}" />
                                <TextBlock Text="{i18n:Localize MainRender_NoBlenderAvailable}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding $parent[UserControl].((vm:MainRenderViewModel)DataContext).BlenderValidationMessage, Converter={StaticResource LocalizeConverter}}"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem x:Name="LogsMenuItem"
                                       Header="{i18n:Localize MainRender_Logs}"
                                       Classes="Compact"
                                       Tag="1"
                                       Tapped="OnNavigationMenuItemTapped">
                    <suki:SukiSideMenuItem.Icon>
                        <avalonia:MaterialIcon Kind="TextBoxSearch" Width="24" Height="24" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <suki:GlassCard Margin="8">
                            <views:GlobalLogView DataContext="{Binding GlobalLog}" />
                        </suki:GlassCard>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <!-- 设置页面 -->
                <suki:SukiSideMenuItem x:Name="SettingsMenuItem"
                                       Header="{i18n:Localize Settings}"
                                       Classes="Compact"
                                       IsTopMenuExpanded="False"
                                       Tag="2"
                                       Tapped="OnNavigationMenuItemTapped">
                    <suki:SukiSideMenuItem.Icon>
                        <avalonia:MaterialIcon Kind="Settings" Width="24" Height="24" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <suki:GlassCard Margin="8">
                            <views:SettingsView DataContext="{Binding SettingsViewModel}" />
                        </suki:GlassCard>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem x:Name="InfoMenuItem"
                                       Header="Info"
                                       IsVisible="False">
                    <suki:SukiSideMenuItem.Icon>
                        <avalonia:MaterialIcon Kind="InfoCircleOutline" Width="24" Height="24" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <views:InfoView DataContext="{Binding}" />
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>

            <suki:SukiSideMenu.HeaderContent>
            </suki:SukiSideMenu.HeaderContent>

            <suki:SukiSideMenu.FooterContent>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.Styles>
                        <!-- <Style Selector="Button"> -->
                        <!--     <Setter Property="Command" Value="{Binding OpenUrlCommand}" /> -->
                        <!-- </Style> -->
                        <Style Selector="avalonia|MaterialIcon">
                            <Setter Property="Width" Value="25" />
                            <Setter Property="Height" Value="25" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="Basic"
                            ToolTip.Tip="Open On GitHub.">
                        <avalonia:MaterialIcon Kind="Github" />
                    </Button>
                    <Button Classes="Basic"
                            Command="{Binding ShowInfoPageCommand}"
                            ToolTip.Tip="Information About The Application.">
                        <avalonia:MaterialIcon Kind="InfoCircleOutline" />
                    </Button>
                </StackPanel>
            </suki:SukiSideMenu.FooterContent>
        </suki:SukiSideMenu>

    </Grid>

</UserControl>
