<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BlenderRenderQueue.ViewModels"
             xmlns:controls="using:BlenderRenderQueue.Controls"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="150"
             x:Class="BlenderRenderQueue.Views.HardwareChartView"
             x:DataType="vm:HardwareChartViewModel">

    <Design.DataContext>
        <vm:HardwareChartViewModel />
    </Design.DataContext>
    
    <suki:BusyArea IsBusy="{Binding IsLoading}" BusyText="{i18n:Localize Loading}">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,8,*">

            <!-- 正常状态显示 -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="4"
                        IsVisible="{Binding !IsLoading}">
                <TextBlock Text="C" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="P" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="U" FontWeight="Bold" FontSize="16" />
            </StackPanel>

            <Border Grid.Row="0" Grid.Column="1"
                    Background="{DynamicResource SukiPrimaryColor10}"
                    Padding="0"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    IsVisible="{Binding !IsLoading}">
                <controls:MiniUsageChartControl Height="60"
                                                Margin="4 2"
                                                Values="{Binding CpuLoadValues}"
                                                MinValue="0"
                                                MaxValue="100"
                                                Fill="#80808080"
                                                Stroke="#A0A0A0"
                                                StrokeThickness="1.5" />
            </Border>
            <StackPanel Grid.Row="2" Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="4"
                        IsVisible="{Binding !IsLoading}">
                <TextBlock Text="G" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="P" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="U" FontWeight="Bold" FontSize="16" />
            </StackPanel>

            <!-- GPU使用率图表 -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="{DynamicResource SukiPrimaryColor10}"
                    Margin="0"
                    Padding="0"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    IsVisible="{Binding !IsLoading}">
                <controls:MiniUsageChartControl Height="60"
                                                Margin="4 2"
                                                Values="{Binding GpuLoadValues}"
                                                MinValue="0"
                                                MaxValue="100"
                                                Fill="#80808080"
                                                Stroke="#A0A0A0"
                                                StrokeThickness="1.5" />
            </Border>
        </Grid>
    </suki:BusyArea>
    
</UserControl>
