<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:logVm="clr-namespace:BlenderRenderQueue.ViewModels.Logs"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.GlobalLogView"
             x:DataType="vm:GlobalLogViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Margin="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{i18n:Localize GlobalLog_Title}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding RefreshEntriesCommand}"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Classes="Basic Icon"
                        ToolTip.Tip="{i18n:Localize Queue_Refresh}">
                    <avalonia:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
                <Button Content="{i18n:Localize GlobalLog_ClearHistory}"
                        Command="{Binding ClearHistoryCommand}"
                        Classes="Flat Rounded"
                        IsVisible="{Binding HasHistoricalEntries}" />
                <Button Content="{i18n:Localize GlobalLog_ClearAll}"
                        Command="{Binding ClearAllCommand}"
                        Classes="Flat Rounded" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,*,*,*,*"
              ColumnSpacing="8">
            <TextBox PlaceholderText="{i18n:Localize GlobalLog_Search}"
                     Text="{Binding SearchText}"
                     MinWidth="260" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LevelOptions}"
                      SelectedItem="{Binding SelectedLevel}"
                      MinWidth="170">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding ScopeOptions}"
                      SelectedItem="{Binding SelectedScope}"
                      MinWidth="150">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding SessionOptions}"
                      SelectedItem="{Binding SelectedSession}"
                      MinWidth="150">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding TaskOptions}"
                      SelectedItem="{Binding SelectedTask}"
                      MinWidth="180">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalLogViewModel+TaskFilterOption">
                        <TextBlock Text="{Binding DisplayLabel}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding FilterSummaryText}"
                   FontSize="12"
                   Opacity="0.62"
                   Margin="2 0 0 0" />

        <Border Grid.Row="3" Padding="0 4 0 0">
            <Grid>
                <TextBlock Text="{i18n:Localize GlobalLog_NoEntries}"
                           IsVisible="{Binding !HasEntries}"
                           Opacity="0.7"
                           Margin="8" />

                <ListBox
                        IsVisible="{Binding HasEntries}"
                        ItemsSource="{Binding Entries}"
                        Classes="Void Stack BrqInteractiveList"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Margin" Value="0 0 0 4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="logVm:GlobalLogEntryViewModel">
                            <Border Padding="12,9"
                                    Background="Transparent">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding TimeText}"
                                                         FontWeight="SemiBold"
                                                         FontSize="12"
                                                         VerticalAlignment="Top"
                                                         Margin="0 2 0 0"
                                                         Opacity="0.82" />

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border CornerRadius="7" Padding="6,2" Background="#283B5E">
                                                <TextBlock Text="{Binding ScopeText}" FontSize="10" />
                                            </Border>
                                            <Border CornerRadius="7" Padding="6,2" Background="#3B3224">
                                                <TextBlock Text="{Binding LevelText}" FontSize="10" />
                                            </Border>
                                            <Border CornerRadius="7"
                                                    Padding="6,2"
                                                    Background="#29313A"
                                                    IsVisible="{Binding ShowSessionBadge}">
                                                <TextBlock Text="{Binding SessionText}" FontSize="10" />
                                            </Border>
                                            <SelectableTextBlock Text="{Binding TaskText}"
                                                                 IsVisible="{Binding HasTask}"
                                                                 Opacity="0.62"
                                                                 FontSize="12"
                                                                 VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12.5" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                                Command="{Binding NavigateToTaskCommand}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Classes="Basic Icon"
                                            ToolTip.Tip="{i18n:Localize GlobalLog_OpenTask}"
                                            IsVisible="{Binding HasTask}">
                                        <avalonia:MaterialIcon Kind="OpenInNew" Width="17" Height="17" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
