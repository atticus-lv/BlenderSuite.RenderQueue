<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:logVm="clr-namespace:BlenderRenderQueue.ViewModels.Logs"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.GlobalLogView"
             x:DataType="vm:GlobalLogViewModel">

    <Grid RowDefinitions="Auto,*" Margin="8">
        <StackPanel Spacing="8">
            <TextBlock Text="{i18n:Localize GlobalLog_Title}" FontSize="22" FontWeight="SemiBold" />
            <WrapPanel Orientation="Horizontal" ItemWidth="220">
                <TextBox Watermark="{i18n:Localize GlobalLog_Search}"
                         Text="{Binding SearchText}"
                         MinWidth="220" />
                <ComboBox ItemsSource="{Binding ScopeOptions}"
                          SelectedItem="{Binding SelectedScope}"
                          MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding LevelOptions}"
                          SelectedItem="{Binding SelectedLevel}"
                          MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding SessionOptions}"
                          SelectedItem="{Binding SelectedSession}"
                          MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding ., Converter={StaticResource LocalizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding TaskOptions}"
                          SelectedItem="{Binding SelectedTask}"
                          MinWidth="220">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GlobalLogViewModel+TaskFilterOption">
                            <TextBlock Text="{Binding DisplayLabel}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{i18n:Localize Queue_Refresh}" Command="{Binding RefreshEntriesCommand}" Classes="Rounded" />
                <Button Content="{i18n:Localize GlobalLog_ClearHistory}"
                        Command="{Binding ClearHistoryCommand}"
                        IsEnabled="{Binding HasHistoricalEntries}"
                        Classes="Rounded" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0 12 0 0" Padding="8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="{i18n:Localize GlobalLog_NoEntries}"
                           IsVisible="{Binding !HasEntries}"
                           Opacity="0.7"
                           Margin="8" />

                <ListBox Grid.Row="1"
                        IsVisible="{Binding HasEntries}"
                        ItemsSource="{Binding Entries}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Margin" Value="0 0 0 4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ suki|GlassCard#BorderBasicStyle">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="logVm:GlobalLogEntryViewModel">
                            <suki:GlassCard IsAnimated="False" Padding="0">
                                <StackPanel Spacing="4" Margin="6">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="5">
                                        <SelectableTextBlock Grid.Column="0"
                                                             Text="{Binding TimestampText}"
                                                             FontWeight="SemiBold"
                                                             FontSize="12" />
                                        <Border Grid.Column="1" CornerRadius="8" Padding="5,1" Background="#223B82F6">
                                            <TextBlock Text="{Binding ScopeText}" FontSize="10" />
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="5,1" Background="#22F59E0B">
                                            <TextBlock Text="{Binding LevelText}" FontSize="10" />
                                        </Border>
                                        <SelectableTextBlock Grid.Column="3"
                                                             Text="{Binding TaskText}"
                                                             Opacity="0.7"
                                                             FontSize="12" />
                                        <Button Grid.Column="4"
                                                Content="{i18n:Localize GlobalLog_OpenTask}"
                                                Command="{Binding NavigateToTaskCommand}"
                                                Classes="Rounded"
                                                FontSize="10"
                                                IsVisible="{Binding HasTask}" />
                                    </Grid>

                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />

                                    <SelectableTextBlock Text="{Binding SessionText}" FontSize="10" Opacity="0.6" />
                                </StackPanel>
                            </suki:GlassCard>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
