<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderSuite.RenderQueue.ViewModels"
             xmlns:controls="clr-namespace:CherylUI.Controls;assembly=CherylUI"
             xmlns:glassMorphism="clr-namespace:CherylUI.Controls.GlassMorphism;assembly=CherylUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BlenderSuite.RenderQueue.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

    <ScrollViewer>
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto">

            <!-- 标题 -->
            <TextBlock Text="Connection"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <!-- 服务器URL输入 -->
            <glassMorphism:GlassCard Grid.Row="1" Margin="0 10">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <TextBlock FontSize="16" Classes="DemiBold" Margin="4,0,0,0" Text="Server Url" />
                        <TextBox FontSize="16"
                                 Text="{Binding ServerUrl, Mode=TwoWay}"
                                 Watermark="http://192.168.101.174:8080" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Content="Connect" FontSize="16" FontWeight="Bold"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding !IsConnecting}" />
                        <Button Content="Disconnect" FontSize="16" FontWeight="Bold"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding IsConnected}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock FontSize="16" FontWeight="DemiBold" Margin="4 0 0 0">Auto Refresh</TextBlock>
                        <ToggleButton Grid.Column="2" Classes="Switch"
                                      VerticalAlignment="Center" Margin="10"
                                      IsChecked="{Binding AutoRefreshEnabled}"
                                      IsEnabled="{Binding IsConnected}" />
                    </Grid>
                </StackPanel>

            </glassMorphism:GlassCard>

            <glassMorphism:GlassCard Grid.Row="2" Margin="0 10">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
                        <Ellipse Width="16" Height="16"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 错误信息显示 -->
                    <Border Background="#FFE6E6"
                            BorderBrush="#FF9999"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="10,0"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connection Error"
                                       FontWeight="Bold"
                                       Foreground="#CC0000" />
                            <SelectableTextBlock Text="{Binding ErrorMessage}"
                                                 Foreground="#CC0000"
                                                 TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding IsConnected}">
                        <TextBlock Text="{Binding ServerVersion, StringFormat='Version: {0}'}"
                                   Opacity="0.7" />
                        <TextBlock
                            Text="{Binding LastConnected, StringFormat='Last Connected: {0:yyyy-MM-dd HH:mm:ss}'}"
                            Opacity="0.7" />
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsConnecting}"
                                 Height="4" />
                </StackPanel>
            </glassMorphism:GlassCard>

        </Grid>
    </ScrollViewer>
</UserControl>