<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderSuite.RenderQueue.ViewModels"
             xmlns:controls="clr-namespace:CherylUI.Controls;assembly=CherylUI"
             xmlns:glassMorphism="clr-namespace:CherylUI.Controls.GlassMorphism;assembly=CherylUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BlenderSuite.RenderQueue.Views.QueueInfoView"
             x:DataType="vm:QueueInfoViewModel">

    <ScrollViewer>
        <StackPanel Margin="15" Spacing="8">

            <!-- 标题 -->
            <TextBlock Text="Queue Information"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <!-- 错误信息 -->
            <Border Background="#FFE6E6"
                    BorderBrush="#FF9999"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#CC0000"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 加载指示器 -->
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="8" />

            <!-- 队列状态概览 -->
            <controls:GroupBox Header="Queue Status">
                <StackPanel Margin="10" Spacing="4">
                    <Grid ColumnDefinitions="*,4,Auto">
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProgressText}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <!-- Progress Bar -->
                        <ProgressBar Grid.Column="0"
                                     Value="{Binding OverallProgress}"
                                     Maximum="1.0"
                                     Height="20"
                                     Margin="0,0,0,8" />
                    </Grid>
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{Binding QueueStateText}"
                            FontSize="20"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding TaskSummary}"
                            FontSize="20"
                            VerticalAlignment="Center" />


                        <TextBlock
                            Text="{Binding FrameSummary}"
                            FontSize="20"
                            Opacity="0.7"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding RemainingTime,StringFormat=Remaining Time: {}}"
                            FontSize="20"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

            </controls:GroupBox>


            <!-- 当前任务 -->
            <controls:GroupBox Header="Current Task">
                <StackPanel Margin="10" Spacing="4">
                    <Grid ColumnDefinitions="*,4,Auto">
                        <!-- Task Progress -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentTaskProgressText}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <ProgressBar Grid.Column="0"
                                     Value="{Binding CurrentTaskProgress}"
                                     Maximum="1.0"
                                     Height="16"
                                     Margin="0,0,0,8" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

                        <!-- Task Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Task Name:"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CurrentTaskName}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Margin="0,0,0,8" />


                    </Grid>
                </StackPanel>

            </controls:GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>