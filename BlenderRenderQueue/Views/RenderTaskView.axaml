<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:design="clr-namespace:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BlenderRenderQueue.Views.RenderTaskView"
             x:DataType="vm:RenderTaskViewModel">

    <Design.DataContext>
        <design:DesignTimeRenderTaskViewModel />
    </Design.DataContext>


    <Grid>
        <StackPanel Spacing="8" HorizontalAlignment="Stretch">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8" Margin="8">
                    <TextBlock Text="{Binding BlendFileName}" FontWeight="Bold" FontSize="20"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                        <Border
                            Background="{Binding Status, Converter={x:Static vm:RenderTaskViewModel.StatusToColorConverter}}"
                            CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                                   VerticalAlignment="Center" FontSize="14" />


                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8" VerticalAlignment="Center">
                    <Button Command="{Binding OpenInBlenderCommand}"
                            IsEnabled="True"
                            Classes="Outlined Rounded"
                            IsVisible="{Binding IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="BlenderSoftware" />
                            <TextBlock Text="编辑" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenFileDirectoryCommand}"
                            IsEnabled="True"
                            Classes="Outlined Rounded"
                            IsVisible="{Binding IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="FolderOpen" />
                            <TextBlock Text="打开文件夹" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshFileInfoCommand}"
                            Classes="Rounded Outlined Small"
                            IsVisible="{Binding IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshFileInfoCommand}"
                            Classes="Rounded Danger"
                            IsVisible="{Binding !IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="Refresh" />
                            <TextBlock Text="文件错误" Margin="4 0 0 0"></TextBlock>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
            <suki:GlassCard Grid.Column="1">
                <StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="4">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,5,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="大小:" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding FileInfo.FileSizeFormatted}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="创建:" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding FileInfo.CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="修改:" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{Binding FileInfo.LastModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="路径:" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <SelectableTextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FileInfo.FilePath}"
                                                     VerticalAlignment="Center"
                                                     TextWrapping="NoWrap">
                                </SelectableTextBlock>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <TabControl IsVisible="{Binding IsValid}">
                    <TabItem Header="场景信息">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8 4">
                            <!-- 场景信息 -->
                            <views:BlendScenePropertiesView DataContext="{Binding ScenePropertiesView}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="渲染设置">
                        <!-- 渲染设置 -->
                        <StackPanel Spacing="12" Margin="8 4">
                            <!-- 动画渲染设置 -->
                            <StackPanel Spacing="8">
                                <CheckBox Content="渲染动画" IsChecked="{Binding Animation}" />
                                <StackPanel IsVisible="{Binding Animation}" Spacing="8" Margin="16,0,0,0">
                                    <CheckBox Content="覆写帧范围" IsChecked="{Binding OverrideFrameRange}">
                                        <CheckBox.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding
                                                    Path="$parent[UserControl].((vm:RenderQueueViewModel)DataContext).CanModifyTasks"
                                                    Converter="{x:Static BoolConverters.Not}" />
                                                <Binding Path="CanModifyOverride" />
                                            </MultiBinding>
                                        </CheckBox.IsEnabled>
                                    </CheckBox>
                                    <StackPanel IsVisible="{Binding OverrideFrameRange}" Spacing="8" Margin="16,0,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="起始帧:"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StartFrame}"
                                                           Minimum="1" Maximum="100000" Width="120">
                                                <NumericUpDown.IsEnabled>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding
                                                            Path="$parent[UserControl].((vm:RenderQueueViewModel)DataContext).CanModifyTasks"
                                                            Converter="{x:Static BoolConverters.Not}" />
                                                        <Binding Path="CanModifyOverride" />
                                                    </MultiBinding>
                                                </NumericUpDown.IsEnabled>
                                            </NumericUpDown>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="结束帧:"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding EndFrame}"
                                                           Minimum="1" Maximum="100000" Width="120">
                                                <NumericUpDown.IsEnabled>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding
                                                            Path="$parent[UserControl].((vm:RenderQueueViewModel)DataContext).CanModifyTasks"
                                                            Converter="{x:Static BoolConverters.Not}" />
                                                        <Binding Path="CanModifyOverride" />
                                                    </MultiBinding>
                                                </NumericUpDown.IsEnabled>
                                            </NumericUpDown>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 场景覆写设置 -->
                            <StackPanel Spacing="8">
                                <CheckBox Content="覆写场景" IsChecked="{Binding OverrideScene}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding
                                                Path="$parent[UserControl].((vm:RenderQueueViewModel)DataContext).CanModifyTasks"
                                                Converter="{x:Static BoolConverters.Not}" />
                                            <Binding Path="CanModifyOverride" />
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                <StackPanel IsVisible="{Binding OverrideScene}" Spacing="8" Margin="16,0,0,0">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="场景:"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding AvailableSceneNames}"
                                                  SelectedItem="{Binding SelectedSceneName}"
                                                  Width="200" HorizontalAlignment="Left">
                                            <ComboBox.IsEnabled>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding
                                                        Path="$parent[UserControl].((vm:RenderQueueViewModel)DataContext).CanModifyTasks"
                                                        Converter="{x:Static BoolConverters.Not}" />
                                                    <Binding Path="CanModifyOverride" />
                                                </MultiBinding>
                                            </ComboBox.IsEnabled>
                                        </ComboBox>
                                    </Grid>

                                    <!-- 场景选择警告 -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                                            Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1"
                                            CornerRadius="4" Padding="8" Margin="0,4,0,0"
                                            IsVisible="{Binding ShowSceneOverrideWarning}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="选择的场景在当前文件中不存在，将使用默认场景渲染"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="#856404" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </TabItem>
                    <TabItem Header="日志">
                        <Grid RowDefinitions="Auto,300" Margin="8 4">
                            <!-- 日志控制按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8 0">
                                <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                                        Classes="Flat Outlined" />
                                <Button Content="{Binding LogPauseButtonText}"
                                        Command="{Binding ToggleLogPauseCommand}"
                                        Classes="Flat Outlined" />
                            </StackPanel>

                            <!-- 日志内容 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding OutputLog}" TextWrapping="Wrap" IsReadOnly="True"
                                         AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas" FontSize="12" Padding="8" />
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </suki:GlassCard>
        </StackPanel>


    </Grid>
</UserControl>