<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:design="clr-namespace:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BlenderRenderQueue.Views.RenderTaskView"
             x:DataType="vm:RenderTaskViewModel">

    <Design.DataContext>
        <design:DesignTimeRenderTaskViewModel />
    </Design.DataContext>


    <Grid>
        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BlendFileName}" FontWeight="Bold" FontSize="20"
                               VerticalAlignment="Center" />
                    <Border
                        Background="{Binding Status, Converter={x:Static vm:RenderTaskViewModel.StatusToColorConverter}}"
                        CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                               VerticalAlignment="Center" FontSize="14" />

                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8" VerticalAlignment="Center">
                    <Button Command="{Binding OpenInBlenderCommand}"
                            IsEnabled="True"
                            Classes="Outlined Rounded"
                            Width="120"
                            IsVisible="{Binding IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="OpenInNew" />
                            <TextBlock Text="打开文件" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshFileInfoCommand}"
                            Classes="Rounded"
                            IsVisible="{Binding IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="Refresh" />
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding RefreshFileInfoCommand}"
                            Classes="Rounded Danger"
                            IsVisible="{Binding !IsValid}"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="Refresh" />
                            <TextBlock Text="文件错误" Margin="4 0 0 0"></TextBlock>
                        </StackPanel>
                    </Button>
                    
                </StackPanel>
            </Grid>


            <Grid ColumnDefinitions="Auto,8,*">
                <suki:GlassCard>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                        <!-- 预览图区域 -->
                        <suki:GlassCard Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin=" 0 8 16 8">
                            <Grid>
                                <!-- 渲染图片 (优先显示) -->
                                <Image Source="{Binding RenderedImage}"
                                       Stretch="Uniform"
                                       IsVisible="{Binding HasRenderedImage}"
                                       Name="RenderedImageControl"
                                       Cursor="Hand"
                                       DoubleTapped="OnRenderedImageDoubleTapped" />

                                <!-- 文件缩略图 (备选) -->
                                <Image Source="{Binding FileInfo.Thumbnail}"
                                       Stretch="Uniform"
                                       IsVisible="{Binding HasRenderedImage, Converter={x:Static BoolConverters.Not}}" />

                                <!-- 占位符 -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding HasRenderedImage, Converter={x:Static BoolConverters.Not}}">
                                    <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="预览图" FontSize="10" HorizontalAlignment="Center"
                                               Foreground="#666" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </suki:GlassCard>
                        <!-- 任务进度 -->

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   VerticalAlignment="Center" FontWeight="Bold" MinWidth="80">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}进度: {0}/{1} ">
                                    <Binding Path="CompletedFrames" />
                                    <Binding Path="RealTotalFrames" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ProgressBar Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="1"
                                     ShowProgressText="False"
                                     Value="{Binding OverallProgress01}"
                                     Height="20" Margin="0,0,8,0" />

                        <!-- 当前帧进度 -->
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding CurrentFrame, StringFormat='当前帧: {0}'}"
                                   VerticalAlignment="Center" FontWeight="Bold" />
                        <ProgressBar Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1"
                                     Value="{Binding Progress01}" Height="20"
                                     ShowProgressText="False" Margin="0,0,8,0" />

                        <!-- 采样信息 -->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="采样:"
                                   VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Text="{Binding SampleText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />


                    </Grid>
                </suki:GlassCard>
                <suki:GlassCard Grid.Column="2">
                    <StackPanel>

                        <Grid ColumnDefinitions="*,Auto" Margin="4">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,5,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件大小:" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding FileInfo.FileSizeFormatted}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="创建时间:" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding FileInfo.CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="修改时间:" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               Text="{Binding FileInfo.LastModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="文件路径:" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FileInfo.FilePath}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>


            <suki:GlassCard>
                <TabControl IsVisible="{Binding IsValid}">
                    <TabItem Header="场景信息">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8 16">
                            <!-- 场景信息 -->
                            <views:BlendScenePropertiesView DataContext="{Binding ScenePropertiesView}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="渲染设置">
                        <!-- 渲染设置 -->
                        <StackPanel Spacing="12" Margin="8 16">
                            <!-- 动画渲染设置 -->
                            <StackPanel Spacing="8">
                                <CheckBox Content="渲染动画" IsChecked="{Binding Animation}" />
                                <StackPanel IsVisible="{Binding Animation}" Spacing="8" Margin="16,0,0,0">
                                    <CheckBox Content="覆写帧范围" IsChecked="{Binding OverrideFrameRange}" />
                                    <StackPanel IsVisible="{Binding OverrideFrameRange}" Spacing="8" Margin="16,0,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="起始帧:"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StartFrame}"
                                                           Minimum="1" Maximum="100000" Width="120" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="结束帧:"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding EndFrame}"
                                                           Minimum="1" Maximum="100000" Width="120" />
                                        </Grid>
                                    </StackPanel>
                                    
                                    <CheckBox Content="覆写场景" IsChecked="{Binding OverrideScene}" />
                                    <StackPanel IsVisible="{Binding OverrideScene}" Spacing="8" Margin="16,0,0,0">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="场景:"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" 
                                                      ItemsSource="{Binding AvailableSceneNames}"
                                                      SelectedItem="{Binding SelectedSceneName}"
                                                      Width="200" HorizontalAlignment="Left" />
                                        </Grid>
                                        
                                        <!-- 场景选择警告 -->
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" 
                                                Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1" 
                                                CornerRadius="4" Padding="8" Margin="0,4,0,0"
                                                IsVisible="{Binding ShowSceneOverrideWarning}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock Text="选择的场景在当前文件中不存在，将使用默认场景渲染" 
                                                           FontSize="12" VerticalAlignment="Center" 
                                                           Foreground="#856404" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 超时设置 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="超时:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding RenderTimeoutSeconds}"
                                               Minimum="300" Maximum="7200" Width="120"
                                               HorizontalAlignment="Left"
                                               suki:NumericUpDownExtensions.Unit="秒" />
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="日志">
                        <Grid RowDefinitions="Auto,300" Margin="8 16">
                            <!-- 日志控制按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                                        Classes="Flat" />
                                <Button Content="{Binding LogPauseButtonText}"
                                        Command="{Binding ToggleLogPauseCommand}"
                                        Classes="Flat" />
                            </StackPanel>

                            <!-- 日志内容 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding OutputLog}" TextWrapping="Wrap" IsReadOnly="True"
                                         AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas" FontSize="12" Padding="8" />
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </suki:GlassCard>
        </StackPanel>


    </Grid>
</UserControl>