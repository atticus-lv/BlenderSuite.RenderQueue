<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.RenderTaskView"
             x:DataType="vm:RenderTaskViewModel">


    <Grid>
        
        <suki:GroupBox>
            <!-- 任务标题和状态 -->
            <suki:GroupBox.Header>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BlendFileName}" FontWeight="Bold" FontSize="16"
                               VerticalAlignment="Center" />
                    <Border
                        Background="{Binding Status, Converter={x:Static vm:RenderTaskViewModel.StatusToColorConverter}}"
                        CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                               VerticalAlignment="Center" FontSize="14" Foreground="#666" />
                </StackPanel>
            </suki:GroupBox.Header>
            <TabControl Grid.Row="1">
                <TabItem Header="场景信息">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="8">
                            <!-- 场景信息 -->
                            <suki:GlassCard>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="文件信息" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                                    <views:BlendFilePropertiesView DataContext="{Binding FileProperties}" />
                                </StackPanel>
                            </suki:GlassCard>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="渲染设置">
                    <!-- 渲染设置 -->
                    <suki:GlassCard>
                        <StackPanel Spacing="12">

                            <!-- 动画渲染设置 -->
                            <StackPanel Spacing="8">
                                <CheckBox Content="渲染动画" IsChecked="{Binding Animation}" />

                                <StackPanel IsVisible="{Binding Animation}" Spacing="8" Margin="16,0,0,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起始帧:" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StartFrame}"
                                                       Minimum="1" Maximum="100000" Width="120" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="结束帧:" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding EndFrame}"
                                                       Minimum="1" Maximum="100000" Width="120" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- 超时设置 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="超时:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding RenderTimeoutSeconds}"
                                               Minimum="60" Maximum="3600" Width="120"
                                               HorizontalAlignment="Left"
                                               suki:NumericUpDownExtensions.Unit="秒" />
                            </Grid>
                        </StackPanel>
                    </suki:GlassCard>
                </TabItem>
                <TabItem Header="日志">
                    <Grid RowDefinitions="Auto,*">
                        <!-- 日志控制按钮 -->
                        <suki:GlassCard Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                                        Classes="Flat" />
                                <Button Content="{Binding LogPauseButtonText}"
                                        Command="{Binding ToggleLogPauseCommand}"
                                        Classes="Flat" />
                            </StackPanel>
                        </suki:GlassCard>

                        <!-- 日志内容 -->
                        <suki:GlassCard Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding OutputLog}" TextWrapping="Wrap" IsReadOnly="True"
                                         AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas" FontSize="12" Padding="8" />
                            </ScrollViewer>
                        </suki:GlassCard>
                    </Grid>
                </TabItem>
            </TabControl>
        </suki:GroupBox>


    </Grid>
</UserControl>