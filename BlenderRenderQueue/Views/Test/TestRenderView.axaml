<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels.Test"
             xmlns:services="clr-namespace:BlenderRenderQueue.Services"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             mc:Ignorable="d"
             Width="800" Height="600"
             x:Class="BlenderRenderQueue.Views.Test.TestRenderView"
             x:DataType="vm:TestRenderViewModel"
             services:ToplevelService.Register="{Binding}">
    <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="8" Spacing="6">
                    <TextBlock Text="全部" VerticalAlignment="Center" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallProgress01}" Height="18" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8" Spacing="6">
                    <TextBlock Text="当前帧" VerticalAlignment="Center" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress01}" Height="18" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="8"
                        Spacing="8">
                <Button Content="开始渲染" Command="{Binding StartRenderCommand}" />
                <Button Content="停止" Command="{Binding StopRenderCommand}" />
                <Button Content="清空日志" Command="{Binding ClearLogCommand}" />

            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="8" Spacing="8"
                    HorizontalAlignment="Center">
            <TextBlock Text="无活动超时(秒):" VerticalAlignment="Center" />
            <NumericUpDown Width="150" Value="{Binding RenderTimeoutSeconds,Mode=TwoWay}" Minimum="60" Maximum="3600" />
            <TextBlock Text="(默认300秒=5分钟，有输出时重置)" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>

        <Grid ColumnDefinitions="3*,5,*">

            <views:BlendScenePropertiesView Grid.Column="2" DataContext="{Binding ScenePropertiesModel}" Margin="4" />

            <Rectangle Grid.Column="1" Width="1" Fill="Gray" Margin="0,8" />

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="8 2 4 2" Text="Blender路径:" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="8 2 0 2" Text="{Binding BlenderPath, Mode=TwoWay}" />
                <Button Grid.Row="0" Grid.Column="2" Margin="0 2 8 2" Content="..."
                        Command="{Binding BrowseBlenderCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="8 2 4 2" Text="Blend文件:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="8 2 0 2" Text="{Binding BlendFilePath, Mode=TwoWay}" />
                <Button Grid.Row="1" Grid.Column="2" Margin="0 2 8 2" Content="..."
                        Command="{Binding BrowseBlendFileCommand}" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8" Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="起始帧:" VerticalAlignment="Center" />
                    <NumericUpDown Width="150" Value="{Binding StartFrame}" Minimum="1" Maximum="100000" />
                    <TextBlock Text="结束帧:" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <NumericUpDown Width="150" Value="{Binding EndFrame}" Minimum="1" Maximum="100000" />
                    <CheckBox Content="动画" IsChecked="{Binding Animation}" Margin="16,0,0,0" />
                </StackPanel>


                <Border Grid.Row="5" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1" Margin="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="4">
                            <TextBlock Text="引擎:" />
                            <TextBlock Text="{Binding Engine}" />
                            <TextBlock Text="当前帧:" />
                            <TextBlock Text="{Binding CurrentFrame}" />
                            <TextBlock Text="采样:" />
                            <TextBlock Text="{Binding SampleText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="保存:" />
                            <TextBlock Text="{Binding SavedPath}" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Grid.Row="6" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1" Margin="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Name="LogScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" MaxHeight="400">
                        <TextBox Text="{Binding OutputLog}" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent" TextChanged="TextBox_OnTextChanged" />
                    </ScrollViewer>
                </Border>

            </Grid>

        </Grid>
    </StackPanel>

</UserControl>