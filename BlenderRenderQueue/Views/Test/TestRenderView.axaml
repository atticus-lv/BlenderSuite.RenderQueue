<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels.Test"
             xmlns:services="clr-namespace:BlenderRenderQueue.Services"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.Test.TestRenderView"
             x:DataType="vm:TestRenderViewModel"
             services:ToplevelService.Register="{Binding}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="8 2 8 2" Text="Blender 路径:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="8 2 8 2" Text="{Binding BlenderPath, Mode=TwoWay}" />
        <Button Grid.Row="0" Grid.Column="2" Margin="8 2 8 2" Content="浏览" Command="{Binding BrowseBlenderCommand}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="8 2 8 2" Text="Blend 文件:" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="8 2 8 2" Text="{Binding BlendFilePath, Mode=TwoWay}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="8 2 8 2" Content="浏览" Command="{Binding BrowseBlendFileCommand}" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8" Spacing="8"
                    HorizontalAlignment="Center">
            <TextBlock Text="起始帧:" VerticalAlignment="Center" />
            <NumericUpDown Width="150" Value="{Binding StartFrame}" Minimum="1" Maximum="100000" />
            <TextBlock Text="结束帧:" Margin="16,0,0,0" VerticalAlignment="Center" />
            <NumericUpDown Width="150" Value="{Binding EndFrame}" Minimum="1" Maximum="100000" />
            <CheckBox Content="动画" IsChecked="{Binding Animation}" Margin="16,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Margin="8" Spacing="6">
                <TextBlock Text="整体进度" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallProgress01}" Height="18" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8" Spacing="6">
                <TextBlock Text="当前帧进度" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress01}" Height="18" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1" Margin="8">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="4">
                <TextBlock Text="引擎:" />
                <TextBlock Text="{Binding Engine}" />
                <TextBlock Text="当前帧:" />
                <TextBlock Text="{Binding CurrentFrame}" />
                <TextBlock Text="采样:" />
                <TextBlock Text="{Binding SampleText}" />
                <TextBlock Text="保存:" />
                <TextBlock Text="{Binding SavedPath}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8"
                    Spacing="8">
            <Button Content="开始渲染" Command="{Binding StartRenderCommand}" />
            <Button Content="停止" Command="{Binding StopRenderCommand}" />
        </StackPanel>

        <Border Grid.Row="6" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1" Margin="8">
            <ScrollViewer MinHeight="200" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" MaxWidth="1000">
                <TextBlock Text="{Binding OutputLog}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>


    </Grid>
</UserControl>