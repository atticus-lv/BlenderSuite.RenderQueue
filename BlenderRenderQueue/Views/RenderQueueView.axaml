<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:design="clr-namespace:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:viewModels="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:services1="clr-namespace:BlenderRenderQueue.Services"
             xmlns:behaviors="clr-namespace:BlenderRenderQueue.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:controls="clr-namespace:BlenderRenderQueue.Controls"
             xmlns:animations="clr-namespace:SukiUI.Animations;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="BlenderRenderQueue.Views.RenderQueueView"
             x:DataType="viewModels:RenderQueueViewModel"
             services1:ToplevelService.Register="{Binding}">

    <Design.DataContext>
        <design:DesignTimeRenderQueueViewModel />
    </Design.DataContext>


    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

        <Grid Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <suki:GlassCard Margin="8 4 4 4">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="100"
                             Height="100" Margin="0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <suki:CircleProgressBar Value="{Binding OverallQueueProgressInt}">
                            <TextBlock Margin="1,1,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Text="{Binding OverallQueueProgressInt,StringFormat={}{0}%}" />
                        </suki:CircleProgressBar>
                    </Viewbox>
                    <StackPanel Margin="24 0 0 0" VerticalAlignment="Center">
                        <!-- 进度信息 -->
                        <StackPanel Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueStatusText}" FontWeight="Bold" />

                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}成功: {0} | 失败: {1}">
                                        <Binding Path="CompletedTaskCount" />
                                        <Binding Path="FailedTaskCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <!-- <TextBlock Text="{Binding TotalFrames, StringFormat='总帧数: {0}'}" /> -->
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}帧: {0} | {1}">
                                        <Binding Path="CompletedFrames" />
                                        <Binding Path="TotalFrames" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <!-- 剩余时间显示 -->
                            <TextBlock Text="{Binding RemainingTimeText,StringFormat=剩余时间: {0}}"
                                       FontSize="16"
                                       FontFamily="Foran"
                                       FontWeight="Bold"
                                       IsVisible="{Binding IsQueueRunning}"
                                       Foreground="{DynamicResource SukiSuccessDarkColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>


                    </StackPanel>

                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard Grid.Column="1" Margin="4" IsVisible="{Binding IsQueueRunning}">
                <views:RenderTaskProgressPreviewView DataContext="{Binding CurrentRenderingTask}"
                                                     IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                     Margin="16  0 " />
            </suki:GlassCard>
            <suki:GlassCard Grid.Column="2" Margin="4">
                <Expander ExpandDirection="Left">
                    <Expander.Header>Devices</Expander.Header>
                    <Expander.Content>
                        <controls:HardwareMonitorControl />
                    </Expander.Content>
                </Expander>
            </suki:GlassCard>
            <suki:GlassCard Grid.Column="3" Margin="4 4 8 4"
                            animations:SquishyOverExtensions.Enable="True"
                            animations:SquishyOverExtensions.Intensity="0.2"
                            animations:SquishyOverExtensions.SquishDepth="0.1">
                <StackPanel Orientation="Vertical" Spacing="8"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- 开始队列按钮：只在队列停止时显示 -->
                        <Button Classes="Flat Rounded" Command="{Binding StartQueueCommand}"
                                IsEnabled="{Binding CanStartQueue}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="BlenderSoftware" Width="24" Height="24" />
                                <TextBlock Text="开始队列" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 停止队列按钮：只在队列运行时显示 -->
                        <Button Classes="Danger Small Rounded" Command="{Binding StopQueueCommand}"
                                IsEnabled="{Binding CanStopQueue}">
                            <material:MaterialIcon Kind="Stop" Width="24" Height="24" />
                        </Button>
                    </StackPanel>

                    <!-- 生成视频按钮：按下后隐藏，显示进度条 -->
                    <Button Classes="Rounded" Command="{Binding GenerateVideoFromSelectedTaskCommand}"
                            suki:ButtonExtensions.ShowProgress="{Binding IsGeneratingVideo}"
                            ToolTip.Tip="为选中的任务生成 H.265 视频（需要设置有效的 FFmpeg 路径和帧路径目录中有图片文件）">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SelectedTask"
                                         Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                                <Binding Path="!IsGeneratingVideo" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎬" VerticalAlignment="Center" />
                                <TextBlock Text="生成视频" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                </StackPanel>

            </suki:GlassCard>
        </Grid>


        <!-- 主要内容区域 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1*,0,2*" Margin="4">

            <!-- 左侧任务列表 -->
            <Border Grid.Column="0" Margin="4">
                <Grid RowDefinitions="Auto,*,Auto">


                    <!-- 任务列表 -->
                    <suki:GlassCard Grid.Row="1" Padding="0">
                        <Grid>
                            <!-- 叠加在ListBox上方的按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.8"
                                        ZIndex="1">
                                <Button Command="{Binding AddMultipleTasksCommand}"
                                        Classes="Flat Rounded">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <material:MaterialIcon Kind="Add" />
                                        <TextBlock Text="添加" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveAllTasksCommand}"
                                        Classes="Flat Danger Small Rounded">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="RenderTasks.Count"
                                                     Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                                            <Binding Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <material:MaterialIcon Kind="Trash" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding RenderTasks}"
                                     Classes="WithoutCheck"
                                     SelectedItem="{Binding SelectedTask}" Margin="4">
                                <i:Interaction.Behaviors>
                                    <behaviors:ListBoxDragDropBehavior />
                                </i:Interaction.Behaviors>
                                <ListBox.Styles>
                                     <Style Selector="ListBoxItem /template/ Border">
                                         <Setter Property="Background" Value="Transparent" />
                                         <Setter Property="Transitions">
                                             <Transitions>
                                                 <BrushTransition Property="Background" Duration="0:0:0.15" />
                                             </Transitions>
                                         </Setter>
                                     </Style>
                                    
                                    <Style Selector="ListBoxItem:pointerover /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
                                    </Style>
                                    <Style Selector="ListBoxItem.isDropTarget /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiAccentColor50}" />
                                    </Style>
                                    <Style Selector="ListBoxItem.isDragTarget /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding $parent[ListBox].Background}" Margin="2"
                                                CornerRadius="4"
                                                Padding="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                                <Panel Margin="0 0 8 0" VerticalAlignment="Center">
                                                    <!-- error icon -->
                                                    <material:MaterialIcon Kind="ErrorOutline"
                                                                           Foreground="{DynamicResource SukiDangerColor}"
                                                                           IsVisible="{Binding !IsValid}" />
                                                    <!-- loading icon -->
                                                    <suki:Loading Width="16" Height="16" LoadingStyle="Simple"
                                                                  IsVisible="{Binding ScenePropertiesView.IsLoading}" />
                                                    <!--render status icon -->
                                                    <Border Width="16" Height="16"
                                                            VerticalAlignment="Top"
                                                            Background="{Binding Status, Converter={x:Static vm:RenderTaskViewModel.StatusToColorConverter}}"
                                                            CornerRadius="8">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsValid" />
                                                                <Binding Path="Enable" />
                                                                <Binding Path="!ScenePropertiesView.IsLoading" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                    </Border>
                                                    <!--not render icon -->
                                                    <Border Width="16" Height="16"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource SukiPrimaryColor10}"
                                                            CornerRadius="8">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsValid" />
                                                                <Binding Path="!Enable" />
                                                                <Binding Path="!ScenePropertiesView.IsLoading" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                    </Border>
                                                </Panel>


                                                <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <Binding Path="BlendFileName" 
                                                                         Converter="{x:Static vm:RenderTaskViewModel.FileNameConverter}" />
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- 加载状态显示 -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding ScenePropertiesView.IsLoading}">
                                                        <TextBlock Text="正在加载..." FontSize="10" Foreground="Gray" />
                                                    </StackPanel>

                                                    <!-- 正常状态显示 -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding !ScenePropertiesView.IsLoading}">
                                                        <!-- 场景覆写信息 -->
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{DynamicResource SukiAccentColor}"
                                                                   IsVisible="{Binding OverrideScene}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="SelectedSceneName" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <!-- 默认场景信息 -->
                                                        <TextBlock FontSize="12" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="SelectedSceneName" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                            <TextBlock.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="IsValid" />
                                                                    <Binding Path="OverrideScene"
                                                                             Converter="{x:Static BoolConverters.Not}" />
                                                                </MultiBinding>
                                                            </TextBlock.IsVisible>
                                                        </TextBlock>

                                                        <TextBlock FontSize="12" IsVisible="{Binding IsValid}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}-{1}">
                                                                    <Binding Path="RealStartFrame" />
                                                                    <Binding Path="RealEndFrame" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <TextBlock Text="文件无效" FontSize="10"
                                                                   Foreground="{DynamicResource SukiDangerColor}"
                                                                   FontWeight="Bold"
                                                                   IsVisible="{Binding IsValid, Converter={x:Static BoolConverters.Not}}" />
                                                    </StackPanel>

                                                    <ProgressBar Minimum="0" Maximum="1"
                                                                 Value="{Binding OverallProgress01}"
                                                                 Height="4" Margin="0,2,0,0">
                                                        <ProgressBar.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsValid" />
                                                                <Binding Path="!ScenePropertiesView.IsLoading" />
                                                            </MultiBinding>
                                                        </ProgressBar.IsVisible>
                                                    </ProgressBar>
                                                </StackPanel>

                                                <!-- Enable ToggleSwitch -->
                                                <ToggleSwitch Grid.Column="2"
                                                              IsEnabled="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).CanModifyTasks}"
                                                              IsChecked="{Binding Enable}"
                                                              Margin="16,0, 0,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="启用/禁用此任务">
                                                    <ToggleSwitch.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="IsValid" />
                                                            <Binding Path="!ScenePropertiesView.IsLoading" />
                                                        </MultiBinding>
                                                    </ToggleSwitch.IsVisible>
                                                </ToggleSwitch>


                                                <!-- 删除按钮区域 -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0"
                                                            IsEnabled="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).CanModifyTasks}">
                                                    <!-- 普通删除按钮 -->
                                                    <Button
                                                        Command="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).RemoveTaskCommand}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Classes="Basic Icon"
                                                        ToolTip.Tip="删除此任务">
                                                        <material:MaterialIcon Kind="Delete" Width="24" Height="24" />
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsValid" />
                                                                <Binding Path="!IsPendingDeletion" />
                                                                <Binding Path="!ScenePropertiesView.IsLoading" />
                                                            </MultiBinding>
                                                        </Button.IsVisible>

                                                    </Button>

                                                    <!-- 确认删除按钮 -->
                                                    <Button
                                                        Command="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).RemoveTaskCommand}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Classes="Danger Icon">
                                                        <material:MaterialIcon Kind="Delete" Width="24" Height="24" />
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsValid" />
                                                                <Binding Path="IsPendingDeletion" />
                                                                <Binding Path="!ScenePropertiesView.IsLoading" />
                                                            </MultiBinding>
                                                        </Button.IsVisible>
                                                    </Button>
                                                </StackPanel>
                                                <!-- 拖拽手柄 -->
                                                <Border Grid.Column="4"
                                                        Width="32"
                                                        VerticalAlignment="Stretch"
                                                        Margin="8,0,0,0"
                                                        Background="Transparent"
                                                        Tag="DragHandle">
                                                    <material:MaterialIcon Kind="Drag"
                                                                           Width="20" Height="20"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="Gray" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>


                    </suki:GlassCard>


                </Grid>
            </Border>


            <!-- 右侧任务详情 -->
            <Border Grid.Column="2" Margin="4">
                <Panel>
                    <!-- 空状态提示 -->
                    <suki:GlassCard
                        >
                        <Panel>
                            <TextBlock Text="选择一个任务查看" FontSize="20" Foreground="Gray" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"
                                       IsVisible="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                            <ScrollViewer>
                                <ContentControl Content="{Binding SelectedTask}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:RenderTaskViewModel">
                                            <views:RenderTaskView DataContext="{Binding}" />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </ScrollViewer>
                        </Panel>


                    </suki:GlassCard>

                </Panel>
            </Border>
        </Grid>


    </Grid>
</UserControl>