<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:viewModels="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:services1="clr-namespace:BlenderRenderQueue.Services"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.RenderQueueView"
             x:DataType="viewModels:RenderQueueViewModel"
             services1:ToplevelService.Register="{Binding}">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">


        <!-- 队列统计信息 -->
        <suki:GlassCard Grid.Row="1" Grid.ColumnSpan="2" Margin="4">
            <Grid ColumnDefinitions="Auto,Auto,*">

                <!-- 整体进度条 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding QueueStatusText}" FontWeight="Bold" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallQueueProgress}"
                                 Width="200" Height="20" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:P1} ({1}/{2})">
                                <Binding Path="OverallQueueProgress" />
                                <Binding Path="CompletedFrames" />
                                <Binding Path="TotalFrames" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 进度信息 -->
                <StackPanel Margin="8 0 " Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompletedTaskCount, StringFormat='已完成: {0}'}" />
                    <TextBlock Text="{Binding FailedTaskCount, StringFormat='失败: {0}'}" />
                    <!-- <TextBlock Text="{Binding TotalFrames, StringFormat='总帧数: {0}'}" /> -->
                </StackPanel>


                <!-- 队列设置 -->
                <!-- <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"> -->
                <!--     <CheckBox Content="自动开始下一个任务" IsChecked="{Binding AutoStartNext}" -->
                <!--               VerticalAlignment="Center" /> -->
                <!-- </StackPanel> -->

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto">

                    <!-- 队列控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <!-- 开始队列按钮：只在队列停止时显示 -->
                        <Button Content="开始队列" Classes="Flat" Command="{Binding StartQueueCommand}"
                                IsEnabled="{Binding CanStartQueue}" />

                        <!-- 停止队列按钮：只在队列运行时显示 -->
                        <Button Content="停止队列" Classes="Flat Accent" Command="{Binding StopQueueCommand}"
                                IsEnabled="{Binding CanStopQueue}" />

                        <!-- 生成视频按钮：按下后隐藏，显示进度条 -->
                        <Button Classes="Flat" Command="{Binding GenerateVideoFromSelectedTaskCommand}"
                                IsEnabled="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                IsVisible="{Binding IsGeneratingVideo, Converter={x:Static conv:BoolConverters.Not}}"
                                ToolTip.Tip="为选中的任务生成 H.265 视频（需要设置有效的 FFmpeg 路径和帧路径目录中有图片文件）">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🎬" VerticalAlignment="Center" />
                                    <TextBlock Text="生成视频" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 视频生成进度条：生成时显示 -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsGeneratingVideo}">
                            <TextBlock Text="🎬" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VideoGenerationStatus}" VerticalAlignment="Center" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding VideoGenerationProgress}"
                                         Width="200" Height="16" VerticalAlignment="Center" ShowProgressText="False" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Grid>
        </suki:GlassCard>


        <!-- 主要内容区域 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1*,5,2*" Margin="4">

            <!-- 左侧任务列表 -->
            <Border Grid.Column="0" Margin="4">
                <Grid RowDefinitions="Auto,*,Auto">


                    <!-- 任务列表 -->
                    <suki:GlassCard Grid.Row="1" Padding="0">
                        <Grid ColumnDefinitions="*,1,Auto">
                            <!-- 任务操作按钮 -->
                            <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" Margin="4"
                                        HorizontalAlignment="Center">
                                <StackPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </StackPanel.Styles>
                                <Button
                                    Command="{Binding AddMultipleTasksCommand}">
                                    <material:MaterialIcon Kind="Add" />
                                </Button>
                                <Button Command="{Binding RemoveSelectedTaskCommand}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="SelectedTask"
                                                     Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            <Binding
                                                Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <material:MaterialIcon Kind="Remove" />
                                </Button>

                                <Button HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding MoveTaskUpCommand}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding
                                                Path="SelectedTask"
                                                Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            <Binding
                                                Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <material:MaterialIcon Kind="ArrowTop" />
                                </Button>
                                <Button HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding MoveTaskDownCommand}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding
                                                Path="SelectedTask"
                                                Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            <Binding
                                                Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <material:MaterialIcon Kind="ArrowDown" />
                                </Button>

                                <Button Command="{Binding RemoveAllTasksCommand}">
                                    <material:MaterialIcon Kind="Clear" />
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding
                                                Path="SelectedTask"
                                                Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            <Binding
                                                Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>

                            </StackPanel>
                            <ListBox Grid.Column="0" ItemsSource="{Binding RenderTasks}"
                                     Classes="WithoutCheck" IsEnabled="{Binding CanModifyTasks}"
                                     SelectedItem="{Binding SelectedTask}" Margin="4">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor50}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding $parent[ListBox].Background}" Margin="2"
                                                CornerRadius="4"
                                                Padding="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding BlendFileName}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" />
                                                        <TextBlock FontSize="12">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}-{1}">
                                                                    <Binding Path="StartFrame" />
                                                                    <Binding Path="EndFrame" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ProgressBar Minimum="0" Maximum="1"
                                                                 Value="{Binding OverallProgress01}"
                                                                 Height="4" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <!-- Enable ToggleSwitch -->
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding Enable}"
                                                              Margin="8,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="启用/禁用此任务" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>


                    </suki:GlassCard>


                </Grid>
            </Border>

            <!-- 第一个分隔条 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Margin="4"
                          CornerRadius="2" Opacity="0.2" />


            <!-- 右侧任务详情 -->
            <Border Grid.Column="2" Margin="4">
                <ScrollViewer>
                    <StackPanel>
                        <Grid RowDefinitions="Auto,*">
                            <!-- 选中任务的进度条和渲染信息 -->
                            <suki:GlassCard Grid.Row="0" Margin="0,0,0,8"
                                            IsVisible="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- 任务进度 -->

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               VerticalAlignment="Center" FontWeight="Bold" MinWidth="80">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}进度: {0}/{1} ">
                                                <Binding Path="SelectedTask.CompletedFrames" />
                                                <Binding Path="SelectedTask.TotalFrames" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <ProgressBar Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="1"
                                                 ShowProgressText="False"
                                                 Value="{Binding SelectedTask.OverallProgress01}"
                                                 Height="20" Margin="0,0,8,0" />

                                    <!-- 当前帧进度 -->
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding SelectedTask.CurrentFrame, StringFormat='当前帧: {0}'}"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <ProgressBar Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1"
                                                 Value="{Binding SelectedTask.Progress01}" Height="20"
                                                 ShowProgressText="False" Margin="0,0,8,0" />

                                    <!-- 采样信息 -->
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="采样:"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Grid.Row="2" Grid.Column="3"
                                               Text="{Binding SelectedTask.SampleText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <!-- 预览图区域 -->
                                    <suki:GlassCard Grid.Row="0" Grid.RowSpan="3" Grid.Column="0">
                                        <Grid>
                                            <!-- 渲染图片 (优先显示) -->
                                            <Image Source="{Binding SelectedTask.RenderedImage}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding SelectedTask.HasRenderedImage}"
                                                   Name="RenderedImageControl"
                                                   Cursor="Hand"
                                                   DoubleTapped="OnRenderedImageDoubleTapped" />

                                            <!-- 文件缩略图 (备选) -->
                                            <Image Source="{Binding SelectedTask.FileInfo.Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding SelectedTask.HasRenderedImage, Converter={x:Static conv:BoolConverters.Not}}" />

                                            <!-- 占位符 -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding SelectedTask.HasRenderedImage, Converter={x:Static conv:BoolConverters.Not}}">
                                                <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center" />
                                                <TextBlock Text="预览图" FontSize="10" HorizontalAlignment="Center"
                                                           Foreground="#666" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </suki:GlassCard>

                                </Grid>
                            </suki:GlassCard>
                        </Grid>


                        <Panel>
                            <ContentControl Content="{Binding SelectedTask}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:RenderTaskViewModel">
                                        <views:RenderTaskView DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- 空状态提示 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                <TextBlock Text="选择一个任务查看详情" FontSize="16" Foreground="Gray" />
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </ScrollViewer>

            </Border>

        </Grid>


    </Grid>
</UserControl>