    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:viewModels="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:services1="clr-namespace:BlenderRenderQueue.Services"
             xmlns:behaviors="clr-namespace:BlenderRenderQueue.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.RenderQueueView"
             x:DataType="viewModels:RenderQueueViewModel"
             services1:ToplevelService.Register="{Binding}">


    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">


        <!-- 队列统计信息 -->
        <suki:GlassCard Grid.Row="1" Grid.ColumnSpan="2" Margin=" 8 8 8 4">
            <Grid ColumnDefinitions="Auto,Auto,*">

                <!-- 整体进度条 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding QueueStatusText}" FontWeight="Bold" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallQueueProgress}"
                                 Width="200" Height="20" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:P1} ({1}/{2})">
                                <Binding Path="OverallQueueProgress" />
                                <Binding Path="CompletedFrames" />
                                <Binding Path="TotalFrames" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 进度信息 -->
                <StackPanel Margin="8 0 " Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompletedTaskCount, StringFormat='已完成: {0}'}" />
                    <TextBlock Text="{Binding FailedTaskCount, StringFormat='失败: {0}'}" />
                    <!-- <TextBlock Text="{Binding TotalFrames, StringFormat='总帧数: {0}'}" /> -->
                </StackPanel>


                <!-- 队列设置 -->
                <!-- <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"> -->
                <!--     <CheckBox Content="自动开始下一个任务" IsChecked="{Binding AutoStartNext}" -->
                <!--               VerticalAlignment="Center" /> -->
                <!-- </StackPanel> -->

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto">

                    <!-- 队列控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <!-- 开始队列按钮：只在队列停止时显示 -->
                        <Button Content="开始队列" Classes="Flat" Command="{Binding StartQueueCommand}"
                                IsEnabled="{Binding CanStartQueue}" />

                        <!-- 停止队列按钮：只在队列运行时显示 -->
                        <Button Content="停止队列" Classes="Flat Accent" Command="{Binding StopQueueCommand}"
                                IsEnabled="{Binding CanStopQueue}" />

                        <!-- 生成视频按钮：按下后隐藏，显示进度条 -->
                        <Button Classes="Flat" Command="{Binding GenerateVideoFromSelectedTaskCommand}"
                                IsEnabled="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                IsVisible="{Binding IsGeneratingVideo, Converter={x:Static conv:BoolConverters.Not}}"
                                ToolTip.Tip="为选中的任务生成 H.265 视频（需要设置有效的 FFmpeg 路径和帧路径目录中有图片文件）">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🎬" VerticalAlignment="Center" />
                                    <TextBlock Text="生成视频" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- 视频生成进度条：生成时显示 -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsGeneratingVideo}">
                            <TextBlock Text="🎬" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VideoGenerationStatus}" VerticalAlignment="Center" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding VideoGenerationProgress}"
                                         Width="200" Height="16" VerticalAlignment="Center" ShowProgressText="False" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Grid>
        </suki:GlassCard>


        <!-- 主要内容区域 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1*,5,2*" Margin="4">

            <!-- 左侧任务列表 -->
            <Border Grid.Column="0" Margin="4">
                <Grid RowDefinitions="Auto,*,Auto">


                    <!-- 任务列表 -->
                    <suki:GlassCard Grid.Row="1" Padding="0">
                        <Grid>
                            <!-- 叠加在ListBox上方的按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.5"
                                        ZIndex="1">
                                <Button Command="{Binding AddMultipleTasksCommand}"
                                        Classes="Flat Outlined" ToolTip.Tip="添加">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <material:MaterialIcon Kind="Add" />
                                        <TextBlock Text="添加" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveAllTasksCommand}"
                                        Classes="Flat Outlined" ToolTip.Tip="清空">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="RenderTasks.Count"
                                                     Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                                            <Binding Path="CanModifyTasks" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <material:MaterialIcon Kind="Trash" />
                                        <TextBlock Text="清空" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding RenderTasks}"
                                     Classes="WithoutCheck"
                                     SelectedItem="{Binding SelectedTask}" Margin="4">
                                <i:Interaction.Behaviors>
                                    <behaviors:ListBoxDragDropBehavior />
                                </i:Interaction.Behaviors>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor50}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding $parent[ListBox].Background}" Margin="2"
                                                CornerRadius="4"
                                                Padding="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding BlendFileName}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" />
                                                        <TextBlock FontSize="12">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}-{1}">
                                                                    <Binding Path="StartFrame" />
                                                                    <Binding Path="EndFrame" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ProgressBar Minimum="0" Maximum="1"
                                                                 Value="{Binding OverallProgress01}"
                                                                 Height="4" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <!-- Enable ToggleSwitch -->
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding Enable}"
                                                              Margin="8,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="启用/禁用此任务" />
                                                <!-- 删除按钮区域 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                                    <!-- 普通删除按钮 -->
                                                    <Button Command="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).RemoveTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            Width="30" Height="30"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Classes="Basic Icon"
                                                            ToolTip.Tip="删除此任务"
                                                            IsVisible="{Binding IsPendingDeletion, Converter={x:Static conv:BoolConverters.Not}}">
                                                        <material:MaterialIcon Kind="Delete" Width="24" Height="24" />
                                                    </Button>
                                                    
                                                    <!-- 确认删除按钮 -->
                                                    <Button Command="{Binding $parent[UserControl].((viewModels:RenderQueueViewModel)DataContext).RemoveTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            Width="30" Height="30"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Classes="Danger Icon"
                                                            ToolTip.Tip="再次点击确认删除"
                                                            IsVisible="{Binding IsPendingDeletion}">
                                                        <material:MaterialIcon Kind="Delete" Width="24" Height="24" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>


                    </suki:GlassCard>


                </Grid>
            </Border>


            <!-- 右侧任务详情 -->
            <Border Grid.Column="2" Margin="4">
                <Panel>
                    <!-- 空状态提示 -->
                    <TextBlock Text="选择一个任务查看" FontSize="20" Foreground="Gray" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FontWeight="SemiBold"
                               IsVisible="{Binding SelectedTask, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                    <ScrollViewer>
                        <ContentControl Content="{Binding SelectedTask}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:RenderTaskViewModel">
                                    <views:RenderTaskView DataContext="{Binding}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>


    </Grid>
</UserControl>