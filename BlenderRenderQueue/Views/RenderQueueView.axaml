<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:design="clr-namespace:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:viewModels="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:services="clr-namespace:BlenderRenderQueue.Services"
             xmlns:animations="clr-namespace:SukiUI.Animations;assembly=SukiUI"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="BlenderRenderQueue.Views.RenderQueueView"
             x:DataType="viewModels:RenderQueueViewModel"
             services:ToplevelService.Register="{Binding}">

    <Design.DataContext>
        <design:DesignTimeRenderQueueViewModel />
    </Design.DataContext>


    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

        <Grid Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <suki:GlassCard Margin="8 4 4 4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="80"
                                 Height="80"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsQueueRunning}">
                            <suki:CircleProgressBar Value="{Binding OverallQueueProgressInt}">
                                <TextBlock Margin="1,1,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Text="{Binding OverallQueueProgressInt,StringFormat={}{0}%}" />
                            </suki:CircleProgressBar>
                        </Viewbox>
                        <StackPanel Margin="24 0 0 0" VerticalAlignment="Center">
                            <!-- 进度信息 -->
                            <StackPanel Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding QueueStatusText, Converter={StaticResource LocalizeConverter}}"
                                    FontWeight="Bold" />

                                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizeConverter}">
                                            <Binding Source="{}Success: {0} | Failed: {1}" />
                                            <Binding Path="CompletedTaskCount" />
                                            <Binding Path="FailedTaskCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- <TextBlock Text="{Binding TotalFrames, StringFormat='总帧数: {0}'}" /> -->
                                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizeConverter}">
                                            <Binding Source="{}Frames: {0} | {1}" />
                                            <Binding Path="CompletedFrames" />
                                            <Binding Path="TotalFrames" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- 剩余时间显示 -->
                                <TextBlock FontSize="16"
                                           FontFamily="Foran"
                                           FontWeight="Bold"
                                           IsVisible="{Binding IsQueueRunning}"
                                           Foreground="{DynamicResource SukiAccentColor}"
                                           Text="{Binding RemainingTimeText, Converter={StaticResource LocalizeConverter}}"
                                           VerticalAlignment="Center">
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <views:HardwareChartView Grid.Column="1" Width="200" />

                </Grid>

            </suki:GlassCard>
            <suki:GlassCard Grid.Column="1" Margin="4" IsVisible="{Binding IsQueueRunning}">
                <views:RenderTaskProgressPreviewView DataContext="{Binding CurrentRenderingTask}"
                                                     IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                     Margin="16  0 " />
            </suki:GlassCard>
            <!-- 队列按钮部分 -->
            <suki:GlassCard Grid.Column="3" Margin="4 4 8 4"
                            animations:SquishyOverExtensions.Enable="True"
                            animations:SquishyOverExtensions.Intensity="0.2"
                            animations:SquishyOverExtensions.SquishDepth="0.1">
                <StackPanel Orientation="Vertical" Spacing="8"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- 开始队列按钮：没有任务时不可见，有任务时可见但根据可用任务数量决定是否可用 -->
                        <Button Classes="Accent Flat Rounded" Command="{Binding StartQueueCommand}"
                                IsVisible="{Binding CanShowStartQueue}"
                                IsEnabled="{Binding CanStartQueue}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="BlenderSoftware" Width="24" Height="24" />
                                <TextBlock Text="{i18n:Localize Queue_StartQueue}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 暂停队列按钮：只在队列运行时显示 -->
                        <Button Classes="Warning Rounded" Command="{Binding PauseQueueCommand}"
                                IsVisible="{Binding CanPauseQueue}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Pause" Width="24" Height="24" />
                            </StackPanel>
                        </Button>

                        <!-- 恢复队列按钮：只在队列暂停时显示 -->
                        <Button Classes="Success Rounded" Command="{Binding ResumeQueueCommand}"
                                IsVisible="{Binding CanResumeQueue}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Play" Width="24" Height="24" />
                                <TextBlock Text="{i18n:Localize Queue_ResumeQueue}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 停止队列按钮：只在队列运行时显示 -->
                        <Button Classes="Danger Rounded" Command="{Binding StopQueueCommand}"
                                IsVisible="{Binding CanStopQueue}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Stop" Width="24" Height="24" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AddMultipleTasksCommand}"
                                Classes="Flat Rounded">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="AddBold" Width="24" Height="24" />
                                <TextBlock Text="{i18n:Localize Queue_AddTasks}" VerticalAlignment="Center"
                                           IsVisible="{Binding HasNoTasks}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 生成视频按钮：按下后隐藏，显示进度条 -->
                    <Button Classes="Rounded" Command="{Binding GenerateVideoFromSelectedTaskCommand}"
                            suki:ButtonExtensions.ShowProgress="{Binding IsGeneratingVideo}"
                            ToolTip.Tip="为选中的任务生成 H.265 视频（需要设置有效的 FFmpeg 路径和帧路径目录中有图片文件）">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SelectedTask"
                                         Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                                <Binding Path="!IsGeneratingVideo" />
                            </MultiBinding>
                        </Button.IsEnabled>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎬" VerticalAlignment="Center" />
                                <TextBlock Text="{i18n:Localize Queue_GenerateVideo}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                </StackPanel>

            </suki:GlassCard>
        </Grid>

        <SplitView DisplayMode="Inline" Name="RightPanelBorder"
                   Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0" Margin="4">
            <SplitView.IsPaneOpen>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="SelectedTask"
                             Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                    <Binding Path="!HasNoTasks" />
                </MultiBinding>
            </SplitView.IsPaneOpen>
            <SplitView.Pane>
                <!-- 右侧任务详情 -->
                <Border Grid.Column="0" Margin="4">
                    <Panel>
                        <suki:GlassCard IsAnimated="False">
                            <Panel>
                                <ScrollViewer>
                                    <ContentControl Content="{Binding SelectedTask}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="vm:RenderTaskViewModel">
                                                <views:RenderTaskView DataContext="{Binding}" />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </ScrollViewer>
                            </Panel>
                        </suki:GlassCard>
                    </Panel>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <views:RenderQueueTaskListView DataContext="{Binding}" />
            </SplitView.Content>
        </SplitView>


    </Grid>
</UserControl>