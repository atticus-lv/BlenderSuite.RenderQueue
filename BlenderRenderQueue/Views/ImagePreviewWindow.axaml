<suki1:SukiWindow xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:suki="using:SukiUI"
                  xmlns:controls="clr-namespace:BlenderRenderQueue.Controls"
                  xmlns:suki1="https://github.com/kikipoulet/SukiUI"
                  xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
                  x:Class="BlenderRenderQueue.Views.ImagePreviewWindow"
                  Title="{Binding ImagePath}"
                  Width="800"
                  Height="600"
                  MinWidth="400"
                  MinHeight="300"
                  WindowStartupLocation="CenterOwner"
                  ShowBottomBorder="False"
                  TitleBarAutoShowDelay="300"
                  x:DataType="vm:ImagePreviewWindowViewModel">

    <Grid RowDefinitions="*,Auto">


        <!-- 图片预览控件 -->
        <controls:ImagePreviewControl x:Name="ImagePreviewControl" Grid.Row="0" Margin="8" Image="{Binding Image}" />

        <!-- 底部信息栏 -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1" Margin="16 4">
            <SelectableTextBlock Text="{Binding FrameInfo}"
                                 Foreground="#666"
                                 VerticalAlignment="Center" />

            <SelectableTextBlock Text="{Binding FileInfo}"
                                 Foreground="#666"
                                 VerticalAlignment="Center" />

            <SelectableTextBlock Text="{Binding ImageSize}"
                                 Foreground="#666"
                                 VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</suki1:SukiWindow>