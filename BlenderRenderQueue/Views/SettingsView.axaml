<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:objectModel="using:System.Collections.ObjectModel"
             xmlns:models="clr-namespace:BlenderRenderQueue.Models"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             MaxWidth="1000"
             MaxHeight="500"
             x:Class="BlenderRenderQueue.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <suki:SettingsLayout>
        <suki:SettingsLayout.Items>
            <objectModel:ObservableCollection x:TypeArguments="suki:SettingsLayoutItem">

                <!-- Blender 设置部分 -->
                <suki:SettingsLayoutItem Header="Blender">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                            <!-- Blender路径设置 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Blender路径:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BlenderPath, Mode=TwoWay}"
                                     IsReadOnly="True" Margin="0,0,0,0" />
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseBlenderCommand}"
                                    IsEnabled="{Binding IsBlenderPathValid, Converter={x:Static conv:BoolConverters.Not}}"
                                    Classes="Outlined Small"
                                    Margin="0,0,0,0">
                                <avalonia:MaterialIcon Kind="FolderOpen" Width="16"
                                                       Height="16" />
                            </Button>

                            <!-- Blender信息 -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        Margin="0,8,0,0" VerticalAlignment="Center">
                                <SelectableTextBlock Text="{Binding BlenderVersion}" />
                                <SelectableTextBlock Text="{Binding BlenderPlatform}" />
                                <SelectableTextBlock Text="{Binding BlenderBranch}" />
                                <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                             IsVisible="{Binding IsLoadingBlenderInfo}" />
                            </StackPanel>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!-- 渲染超时设置部分 -->
                <suki:SettingsLayoutItem Header="渲染超时">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">

                            <!-- 渲染超时设置 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="渲染超时:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <NumericUpDown Value="{Binding DefaultRenderTimeoutSeconds, Mode=TwoWay}"
                                               Minimum="300" Maximum="7200" Width="120"
                                               suki:NumericUpDownExtensions.Unit="秒" />
                                <TextBlock Text="(5分钟 - 2小时)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SukiTextColorSecondary}" />
                            </StackPanel>

                            <!-- 最大重试次数设置 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大重试:" VerticalAlignment="Center"
                                       Margin="0,16,8,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        Margin="0,16,0,0" VerticalAlignment="Center">
                                <NumericUpDown Value="{Binding MaxRetryAttempts, Mode=TwoWay}"
                                               Minimum="1" Maximum="10" Width="120"
                                               suki:NumericUpDownExtensions.Unit="次" />
                                <TextBlock Text="(1-10次)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SukiTextColorSecondary}" />
                            </StackPanel>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!-- 视频合成设置部分 -->
                <suki:SettingsLayoutItem Header="视频合成">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">

                            <!-- 视频编码 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="视频编码:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding VideoCodec, Mode=TwoWay}"
                                      ItemsSource="{x:Static models:VideoCodecOption.AllOptions}"
                                      Width="200" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:VideoCodecOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 视频质量 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="视频质量:" VerticalAlignment="Center"
                                       Margin="0,16,8,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding VideoQuality, Mode=TwoWay}"
                                      ItemsSource="{x:Static models:VideoQualityOption.AllOptions}"
                                      Width="200" HorizontalAlignment="Left" Margin="0,16,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:VideoQualityOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

            </objectModel:ObservableCollection>
        </suki:SettingsLayout.Items>
    </suki:SettingsLayout>

</UserControl>