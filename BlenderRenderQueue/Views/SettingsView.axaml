<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" Margin="16">

        <!-- 标题 -->


        <!-- Blender路径设置 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Blender:" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BlenderPath, Mode=TwoWay}"
                 IsReadOnly="True" Margin="0,0,0,0" />
        <Button Grid.Row="1" Grid.Column="2" Content="📁" Command="{Binding BrowseBlenderCommand}"
                IsEnabled="{Binding IsBlenderPathValid, Converter={x:Static conv:BoolConverters.Not}}"
                Margin="4,0,0,0" />

        <!-- Blender信息 -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    Margin="0,4,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding BlenderVersion}" />
            <TextBlock Text="{Binding BlenderPlatform}" />
            <TextBlock Text="{Binding BlenderBranch}" />
            <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                         IsVisible="{Binding IsLoadingBlenderInfo}" />
        </StackPanel>
        

        <!-- 渲染超时设置 -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="渲染超时:" VerticalAlignment="Center"
                   Margin="0,16,8,0" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    Margin="0,16,0,0" VerticalAlignment="Center">
            <NumericUpDown Value="{Binding DefaultRenderTimeoutSeconds, Mode=TwoWay}"
                          Minimum="300" Maximum="7200" Width="120"
                          suki:NumericUpDownExtensions.Unit="秒" />
            <TextBlock Text="(5分钟 - 2小时)" VerticalAlignment="Center" 
                       Foreground="{DynamicResource SukiTextColorSecondary}" />
        </StackPanel>

        <!-- 最大重试次数设置 -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="最大重试:" VerticalAlignment="Center"
                   Margin="0,16,8,0" />
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    Margin="0,16,0,0" VerticalAlignment="Center">
            <NumericUpDown Value="{Binding MaxRetryAttempts, Mode=TwoWay}"
                          Minimum="1" Maximum="10" Width="120"
                          suki:NumericUpDownExtensions.Unit="次" />
            <TextBlock Text="(1-10次)" VerticalAlignment="Center" 
                       Foreground="{DynamicResource SukiTextColorSecondary}" />
        </StackPanel>
    </Grid>


</UserControl>