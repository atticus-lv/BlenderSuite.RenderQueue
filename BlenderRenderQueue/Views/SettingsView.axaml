<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:services="clr-namespace:BlenderRenderQueue.Services"
             xmlns:objectModel="using:System.Collections.ObjectModel"
             xmlns:models="clr-namespace:BlenderRenderQueue.Models"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="clr-namespace:BlenderRenderQueue.Converters"
             mc:Ignorable="d"
             MaxWidth="1000"
             MaxHeight="500"
             x:Class="BlenderRenderQueue.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             services:ToplevelService.Register="{Binding}">


    <suki:SettingsLayout MinWidthWhetherStackSummaryShow="800">
        <suki:SettingsLayout.Items>
            <objectModel:ObservableCollection x:TypeArguments="suki:SettingsLayoutItem">

                <!-- Blender 设置部分 -->
                <suki:SettingsLayoutItem Header="{i18n:Localize Blender}">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                            <!-- Blender选择标题和操作按钮 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="选择Blender:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding BrowseBlenderCommand}"
                                        Classes="Outlined"
                                        ToolTip.Tip="添加新的Blender">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="Add" Width="16" Height="16" />
                                        <TextBlock Text="添加Blender" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveBlenderCommand}"
                                        Classes="Outlined"
                                        ToolTip.Tip="移除选中的Blender"
                                        IsEnabled="{Binding SelectedBlenderExecutable, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="Delete" Width="16" Height="16" />
                                        <TextBlock Text="移除选中" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Blender选择卡片区域 -->
                            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding BlenderExecutables}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:BlenderExecutable">
                                            <RadioButton Width="280" Height="160" Margin="4"
                                                         Tag="{Binding .}"
                                                         Classes="GigaChips"
                                                         GroupName="BlenderSelection">
                                                <RadioButton.IsChecked>
                                                    <MultiBinding
                                                        Converter="{StaticResource ObjectEqualMultiConverter}">
                                                        <Binding
                                                            Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).SelectedBlenderExecutable" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </RadioButton.IsChecked>
                                                <RadioButton.Command>
                                                    <Binding
                                                        Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).SelectBlender" />
                                                </RadioButton.Command>
                                                <RadioButton.CommandParameter>
                                                    <Binding Path="." />
                                                </RadioButton.CommandParameter>
                                                <ToolTip.Tip>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontWeight="Bold" Text="Blender 详细信息" />
                                                        <TextBlock Text="{Binding Path, StringFormat='路径: {0}'}" />
                                                        <TextBlock Text="{Binding Version, StringFormat='版本: {0}'}" />
                                                        <TextBlock Text="{Binding Platform, StringFormat='平台: {0}'}" />
                                                        <TextBlock Text="{Binding Branch, StringFormat='分支: {0}'}" />
                                                        <TextBlock Text="{Binding Hash, StringFormat='哈希: {0}'}" />
                                                        <TextBlock Text="{Binding IsValid, StringFormat='状态: {0}'}" />
                                                        <TextBlock
                                                            Text="{Binding LastValidated, StringFormat='验证时间: {0:yyyy-MM-dd HH:mm:ss}'}" />
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                                <StackPanel HorizontalAlignment="Left" Spacing="0,6" Margin="12">
                                                    <!-- 状态图标和标题 -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <avalonia:MaterialIcon Kind="CheckCircle"
                                                                               Width="20"
                                                                               Height="20"
                                                                               Foreground="{DynamicResource SukiSuccessColor}"
                                                                               IsVisible="{Binding IsValid}" />
                                                        <avalonia:MaterialIcon Kind="Error"
                                                                               Width="20"
                                                                               Height="20"
                                                                               Foreground="{DynamicResource SukiDangerColor}"
                                                                               IsVisible="{Binding !IsValid}" />
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="DemiBold"
                                                                   Foreground="{DynamicResource SukiLowText}"
                                                                   Text="STATUS" />
                                                    </StackPanel>

                                                    <!-- 版本-分支 -->
                                                    <TextBlock FontSize="18"
                                                               FontWeight="DemiBold"
                                                               Text="{Binding VersionBranchDisplay}" />

                                                    <!-- 构建日期-时间 -->
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               Text="{Binding BuildDateTimeDisplay}" />

                                                    <!-- 路径信息（头尾显示） -->
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               Text="{Binding FormattedPath}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="20" />

                                                    <!-- 最后验证时间 -->
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               Text="{Binding LastValidated, StringFormat='验证: {0:MM-dd HH:mm}'}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Blender验证状态 -->
                            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                    Background="{DynamicResource SukiDangerDarkColor}"
                                    BorderBrush="{DynamicResource SukiDangerColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding HasBlenderValidationError}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIcon Kind="Error"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{DynamicResource SukiDangerColor}" />
                                    <TextBlock Text="{Binding BlenderValidationMessage}"
                                               Foreground="{DynamicResource SukiDangerColor}"
                                               VerticalAlignment="Center" />
                                    <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                                 IsVisible="{Binding IsLoadingBlenderInfo}" />

                                </StackPanel>
                            </Border>


                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!-- 渲染超时设置部分 -->
                <suki:SettingsLayoutItem Header="{i18n:Localize Render}">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                            <!-- 渲染超时设置 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Localize TimeoutLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <NumericUpDown Value="{Binding DefaultRenderTimeoutSeconds, Mode=TwoWay}"
                                               Minimum="300" Maximum="7200"
                                               suki:NumericUpDownExtensions.Unit="{i18n:Localize Seconds}" />
                            </StackPanel>

                            <!-- 最大重试次数设置 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Localize MaxRetryLabel}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,16,8,0" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        Margin="0,16,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <NumericUpDown Value="{Binding MaxRetryAttempts, Mode=TwoWay}"
                                               Minimum="1" Maximum="10"
                                               suki:NumericUpDownExtensions.Unit="{i18n:Localize Times}" />
                            </StackPanel>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!-- 视频合成设置部分 -->
                <suki:SettingsLayoutItem Header="{i18n:Localize VideoComposition}">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">

                            <!-- 视频编码 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Localize VideoCodec}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,8,0" />
                            <ComboBox Grid.Row="0" Grid.Column="2" SelectedItem="{Binding VideoCodec, Mode=TwoWay}"
                                      ItemsSource="{x:Static models:VideoCodecOption.AllOptions}"
                                      HorizontalAlignment="Right">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:VideoCodecOption">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 视频质量 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Localize VideoQuality}"
                                       VerticalAlignment="Center"
                                       Margin="0,16,8,0" />
                            <ComboBox Grid.Row="1" Grid.Column="2" SelectedItem="{Binding VideoQuality, Mode=TwoWay}"
                                      ItemsSource="{x:Static models:VideoQualityOption.AllOptions}"
                                      HorizontalAlignment="Right" Margin="0,16,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:VideoQualityOption">
                                        <TextBlock
                                            Text="{Binding DisplayName, Converter={x:Static i18n:LocalizeConverter.Instance}}"
                                            VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!-- 语言设置部分 -->
                <suki:SettingsLayoutItem Header="{i18n:Localize General}">
                    <suki:SettingsLayoutItem.Content>
                        <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto">

                            <!-- 语言选择 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Localize LanguageLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox Grid.Row="0" Grid.Column="2" SelectedItem="{Binding Language, Mode=TwoWay}"
                                      ItemsSource="{x:Static models:LanguageOption.AllOptions}"
                                      HorizontalAlignment="Right">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

            </objectModel:ObservableCollection>
        </suki:SettingsLayout.Items>
    </suki:SettingsLayout>

</UserControl>