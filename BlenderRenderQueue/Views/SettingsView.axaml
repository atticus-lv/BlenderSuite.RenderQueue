<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <suki:GroupBox>
           <suki:GroupBox.Header>
               <TextBlock Text="依赖路径"></TextBlock>
           </suki:GroupBox.Header>
        <suki:GroupBox.Content>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" Margin="16">
        
        <!-- 标题 -->
        

        <!-- Blender路径设置 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Blender:" VerticalAlignment="Center" 
                   Margin="0,0,8,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BlenderPath, Mode=TwoWay}" 
                 IsReadOnly="True" Margin="0,0,0,0" />
        <Button Grid.Row="1" Grid.Column="2" Content="📁" Command="{Binding BrowseBlenderCommand}" 
                IsEnabled="{Binding IsBlenderPathValid, Converter={x:Static conv:BoolConverters.Not}}"
                Margin="4,0,0,0" />

        <!-- Blender信息 -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" 
                    Margin="0,4,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding BlenderVersion}" />
            <TextBlock Text="{Binding BlenderPlatform}" />
            <TextBlock Text="{Binding BlenderBranch}" />
            <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                         IsVisible="{Binding IsLoadingBlenderInfo}" />
        </StackPanel>

        <!-- FFmpeg路径设置 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="FFmpeg:" VerticalAlignment="Center" 
                   Margin="0,16,8,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FfmpegPath, Mode=TwoWay}" 
                 IsReadOnly="True" Margin="0,16,0,0" />
        <Button Grid.Row="3" Grid.Column="2" Content="📁" Command="{Binding BrowseFFmpegCommand}" 
                IsEnabled="{Binding IsFFmpegPathValid, Converter={x:Static conv:BoolConverters.Not}}"
                Margin="4,16,0,0" />

        <!-- FFmpeg信息 -->
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" 
                    Margin="0,4,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding FfmpegVersion}" />
            <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                         IsVisible="{Binding IsLoadingFFmpegInfo}" />
        </StackPanel>

    </Grid>
        </suki:GroupBox.Content>
    </suki:GroupBox>
    

</UserControl>
