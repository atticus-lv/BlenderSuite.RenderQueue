<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="BlenderRenderQueue.Views.BlendScenePropertiesView"
             x:DataType="vm:BlendScenePropertiesViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">

                <!-- 加载状态 -->
                <Border CornerRadius="4" Padding="10" IsVisible="{Binding IsLoading}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏳" FontSize="16" />
                        <TextBlock Text="{Binding LoadingMessage}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 错误信息 -->
                <Border CornerRadius="4" Padding="10" IsVisible="{Binding HasErrorMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="❌" FontSize="16" />
                        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#C62828" />
                    </StackPanel>
                </Border>

                <!-- 文件信息 -->
                <Border CornerRadius="4" Padding="15" IsVisible="{Binding SceneProperties.IsLoaded}">
                    <StackPanel Spacing="8">

                        <!-- ~1~ 文件路径 @1@ -->
                        <!-- <Grid ColumnDefinitions="Auto,*"> -->
                        <!--     <TextBlock Grid.Column="0" Text="文件路径:" FontWeight="SemiBold" MinWidth="100" /> -->
                        <!--     <TextBlock Grid.Column="1" Text="{Binding SceneProperties.FilePath}" TextWrapping="Wrap" -->
                        <!--                FontSize="12" Foreground="#1976D2" VerticalAlignment="Center" /> -->
                        <!-- </Grid> -->

                        <!-- 文件名称 -->
                        <!-- <Grid ColumnDefinitions="Auto,*"> -->
                        <!--     <TextBlock Grid.Column="0" Text="文件名称:" FontWeight="SemiBold" MinWidth="100" /> -->
                        <!--     <TextBlock Grid.Column="1" Text="{Binding Properties.FileName}" FontWeight="SemiBold" /> -->
                        <!-- </Grid> -->

                        <!-- 分隔线 -->
                        <!-- <Rectangle Height="1" Fill="Gray" Margin="0,8" /> -->


                        <!-- 场景名称 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="场景:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.SceneName}"
                                       IsVisible="{Binding SceneProperties.SceneName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.SceneName, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- 帧范围 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="帧范围:" FontWeight="SemiBold" MinWidth="80"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SceneProperties.FrameStart}" VerticalAlignment="Center" />
                                <TextBlock Text="~" />
                                <TextBlock Text="{Binding SceneProperties.FrameEnd}" VerticalAlignment="Center" />
                                <TextBlock Text="(" />
                                <TextBlock Text="{Binding SceneProperties.TotalFrames}" VerticalAlignment="Center" />
                                <TextBlock Text="帧 )" />
                            </StackPanel>
                        </Grid>

                        <!-- 渲染引擎 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="渲染引擎:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.RenderEngineDisplayName}"
                                       IsVisible="{Binding SceneProperties.RenderEngine, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.RenderEngine, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- FPS -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="帧率:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.Fps, StringFormat='{}{0:F2} fps'}"
                                       IsVisible="{Binding SceneProperties.Fps, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.Fps, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                        </Grid>


                        <!-- 相机名称 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="相机:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.CameraName}"
                                       IsVisible="{Binding SceneProperties.CameraName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.CameraName, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- 分隔线 -->
                        <Rectangle Height="1" Fill="Gray" Margin="0,8" />

                        <!-- 输出路径 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="输出路径:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.RenderOutputPath}"
                                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding SceneProperties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- Frame Path -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="真实帧路径:" FontWeight="SemiBold" MinWidth="80"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.FramePath}"
                                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding SceneProperties.FramePath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.FramePath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                            <Button Grid.Column="2" Content="📁" ToolTip.Tip="打开文件夹"
                                    Command="{Binding OpenFramePathDirectoryCommand}"
                                    IsEnabled="{Binding CanOpenFramePathDirectory}"
                                    Padding="4" Margin="4,0,0,0" />
                        </Grid>

                        <!-- 输出格式 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="输出格式:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding SceneProperties.RenderOutputFormat}"
                                       IsVisible="{Binding SceneProperties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding SceneProperties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 空状态 -->
                <Border CornerRadius="4" Padding="20" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="文件未加载" HorizontalAlignment="Center"
                                   Foreground="#666" FontStyle="Italic" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>