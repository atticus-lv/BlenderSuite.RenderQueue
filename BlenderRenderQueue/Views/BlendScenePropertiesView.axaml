<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BlenderRenderQueue.ViewModels"
             xmlns:design="using:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="BlenderRenderQueue.Views.BlendScenePropertiesView"
             x:DataType="vm:BlendScenePropertiesViewModel">

    <Design.DataContext>
        <design:DesignTimeBlendScenePropertiesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <!-- 加载状态 -->
                <Border CornerRadius="4" IsVisible="{Binding IsLoading}" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <!-- <ProgressBar IsIndeterminate="True" /> -->
                        <suki:Loading LoadingStyle="Simple" />
                        <TextBlock Text="{Binding LoadingMessage, Converter={StaticResource LocalizeConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 错误信息 -->
                <Border CornerRadius="4" IsVisible="{Binding HasErrorMessage}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="❌" FontSize="16" />
                        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#C62828"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- 文件信息 -->
                <Border CornerRadius="4" Padding="0" IsVisible="{Binding ActiveSceneProperties.IsLoaded}">
                    <Grid ColumnDefinitions="Auto,10,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- 场景选择器 -->
                        <TextBlock Grid.Column="0" Text="{i18n:Localize SceneProperties_Scene}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding SceneNames}"
                                      SelectedItem="{Binding ActiveSceneName}"
                                      Margin="-8 0"
                                      IsEnabled="{Binding !IsLoading}" HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{i18n:Localize SceneProperties_NotDefaultScene}"
                                       FontStyle="Italic" Foreground="#FF9800"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsNotDefaultScene}" />


                        </Grid>

                        <!-- 场景类型 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Localize SceneProperties_SceneType}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.SceneTypeDisplayText, Converter={StaticResource LocalizeConverter}}"
                                   VerticalAlignment="Center" />

                        <!-- 场景信息分隔线 -->
                        <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Height="1" Fill="Transparent" Margin="0,8"
                                   IsVisible="{Binding SceneNames.Count, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

                        <!-- 帧范围 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{i18n:Localize SceneProperties_FrameRange}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveSceneProperties.FrameStart}" VerticalAlignment="Center" />
                            <TextBlock Text="{i18n:Localize SceneProperties_FrameSeparator}" />
                            <TextBlock Text="{Binding ActiveSceneProperties.FrameEnd}" VerticalAlignment="Center" />
                            <TextBlock Text="{i18n:Localize SceneProperties_FrameStartBracket}" />
                            <TextBlock Text="{Binding ActiveSceneProperties.TotalFrames}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{i18n:Localize SceneProperties_FrameEndBracket}" />
                        </StackPanel>

                        <!-- 当前帧 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:Localize SceneProperties_CurrentFrame}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ActiveSceneProperties.FrameCurrent}"
                                   VerticalAlignment="Center" />

                        <!-- FPS -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{i18n:Localize SceneProperties_FrameRate}"
                                   FontWeight="SemiBold" MinWidth="80" />
                        <TextBlock Grid.Row="5" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.Fps, StringFormat='{}{0:F2} fps'}"
                                   IsVisible="{Binding ActiveSceneProperties.Fps, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{i18n:Localize SceneProperties_NotSet}"
                                   Foreground="#666"
                                   IsVisible="{Binding ActiveSceneProperties.Fps, Converter={x:Static conv:ObjectConverters.IsNull}}" />

                        <!-- 分隔线 -->
                        <Rectangle Grid.Row="6" Grid.ColumnSpan="3" Height="1" Fill="Transparent" Margin="0,8" />

                        <!-- 渲染引擎 -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{i18n:Localize SceneProperties_RenderEngine}"
                                   FontWeight="SemiBold" MinWidth="80" />
                        <TextBlock Grid.Row="7" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.RenderEngineDisplayName}"
                                   IsVisible="{Binding ActiveSceneProperties.RenderEngine, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{i18n:Localize SceneProperties_NotSet}"
                                   Foreground="#666"
                                   IsVisible="{Binding ActiveSceneProperties.RenderEngine, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />

                        <!-- Cycles时间限制 -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{i18n:Localize SceneProperties_TimeLimit}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   IsVisible="{Binding ActiveSceneProperties.HasCyclesTimeLimit}" />
                        <TextBlock Grid.Row="8" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.CyclesTimeLimit, StringFormat='{}{0:F1} 秒'}"
                                   IsVisible="{Binding ActiveSceneProperties.HasCyclesTimeLimit}" />

                        <!-- 相机名称 - 单一相机 -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{i18n:Localize SceneProperties_Camera}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   IsVisible="{Binding ActiveSceneProperties.IsMultiCameraScene, Converter={x:Static conv:BoolConverters.Not}}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding ActiveSceneProperties.CameraName}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                    <Binding Path="ActiveSceneProperties.IsMultiCameraScene"
                                             Converter="{x:Static conv:BoolConverters.Not}" />
                                    <Binding Path="ActiveSceneProperties.CameraName"
                                             Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="{i18n:Localize SceneProperties_NotSet}"
                                   Foreground="#666">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                    <Binding Path="ActiveSceneProperties.IsMultiCameraScene"
                                             Converter="{x:Static conv:BoolConverters.Not}" />
                                    <Binding Path="ActiveSceneProperties.CameraName"
                                             Converter="{x:Static conv:StringConverters.IsNullOrEmpty}" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- 相机类型 - 多相机 -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{i18n:Localize SceneProperties_Camera}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ActiveSceneProperties.IsMultiCameraScene}" />
                        <TextBlock Grid.Row="9" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.CameraTypeDisplayText, Converter={StaticResource LocalizeConverter}}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ActiveSceneProperties.IsMultiCameraScene}" />

                        <!-- 分隔线 -->
                        <Rectangle Grid.Row="10" Grid.ColumnSpan="3" Height="1" Fill="Transparent" Margin="0,8" />

                        <!-- 输出路径 -->
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{i18n:Localize SceneProperties_OutputPath}"
                                   FontWeight="SemiBold" MinWidth="80" />
                        <SelectableTextBlock Grid.Row="11" Grid.Column="2"
                                             Text="{Binding ActiveSceneProperties.RenderOutputPath}"
                                             TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                             IsVisible="{Binding ActiveSceneProperties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="{i18n:Localize SceneProperties_NotSet}"
                                   Foreground="#666"
                                   IsVisible="{Binding ActiveSceneProperties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />

                        <!-- Frame Path -->
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{i18n:Localize SceneProperties_RealFramePath}"
                                   FontWeight="SemiBold" MinWidth="80"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="12" Grid.Column="2" ColumnDefinitions="*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="{Binding ActiveSceneProperties.FramePath}"
                                                 TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                                 IsVisible="{Binding ActiveSceneProperties.FramePath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="0" Text="{i18n:Localize SceneProperties_NotSet}" Foreground="#666"
                                       IsVisible="{Binding ActiveSceneProperties.FramePath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                            <Button Grid.Column="1" Classes="Flat Outlined"
                                    Command="{Binding OpenFramePathDirectoryCommand}"
                                    IsEnabled="{Binding CanOpenFramePathDirectory}"
                                    Padding="4" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="FolderOpen" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 输出格式 -->
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="{i18n:Localize SceneProperties_OutputFormat}"
                                   FontWeight="SemiBold" MinWidth="80" />
                        <TextBlock Grid.Row="13" Grid.Column="2"
                                   Text="{Binding ActiveSceneProperties.RenderOutputFormat}"
                                   IsVisible="{Binding ActiveSceneProperties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Grid.Row="13" Grid.Column="2" Text="{i18n:Localize SceneProperties_NotSet}"
                                   Foreground="#666"
                                   IsVisible="{Binding ActiveSceneProperties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />

                    </Grid>
                </Border>

                <!-- 空状态 -->
                <Border CornerRadius="4" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Localize SceneProperties_FileNotLoaded}" HorizontalAlignment="Center"
                                   Foreground="#666" FontStyle="Italic" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>