<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BlenderRenderQueue.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="BlenderRenderQueue.Views.BlendFilePropertiesView"
             x:DataType="vm:BlendFilePropertiesViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">

                <!-- 加载状态 -->
                <Border CornerRadius="4" Padding="10" IsVisible="{Binding IsLoading}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⏳" FontSize="16" />
                        <TextBlock Text="{Binding LoadingMessage}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 错误信息 -->
                <Border CornerRadius="4" Padding="10" IsVisible="{Binding HasErrorMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="❌" FontSize="16" />
                        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#C62828" />
                    </StackPanel>
                </Border>

                <!-- 文件信息 -->
                <Border CornerRadius="4" Padding="15" IsVisible="{Binding Properties.IsLoaded}">
                    <StackPanel Spacing="8">

                        <!-- 文件路径 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="文件路径:" FontWeight="SemiBold" MinWidth="100" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.FilePath}" TextWrapping="Wrap"
                                        FontSize="12" Foreground="#1976D2" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 文件名称 -->
                        <!-- <Grid ColumnDefinitions="Auto,*"> -->
                        <!--     <TextBlock Grid.Column="0" Text="文件名称:" FontWeight="SemiBold" MinWidth="100" /> -->
                        <!--     <TextBlock Grid.Column="1" Text="{Binding Properties.FileName}" FontWeight="SemiBold" /> -->
                        <!-- </Grid> -->

                        <!-- 分隔线 -->
                        <Rectangle Height="1" Fill="Gray" Margin="0,8" />


                        <!-- 场景名称 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="场景:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.SceneName}"
                                       IsVisible="{Binding Properties.SceneName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.SceneName, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- 帧范围 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="帧范围:" FontWeight="SemiBold" MinWidth="80" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Properties.FrameStart}" FontFamily="Consolas" />
                                <TextBlock Text="~" />
                                <TextBlock Text="{Binding Properties.FrameEnd}" FontFamily="Consolas" />
                                <TextBlock Text="(" />
                                <TextBlock Text="{Binding Properties.TotalFrames}" FontFamily="Consolas" />
                                <TextBlock Text="帧)" />
                            </StackPanel>
                        </Grid>

                        <!-- 渲染引擎 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="渲染引擎:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.RenderEngine}"
                                       IsVisible="{Binding Properties.RenderEngine, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.RenderEngine, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- FPS -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="帧率:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.Fps, StringFormat='{}{0:F2} FPS'}"
                                       IsVisible="{Binding Properties.Fps, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.Fps, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                        </Grid>

                      

                        <!-- 相机名称 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="相机:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.CameraName}"
                                       IsVisible="{Binding Properties.CameraName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.CameraName, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                        <!-- 分隔线 -->
                        <Rectangle Height="1" Fill="Gray" Margin="0,8" />

                        <!-- 输出路径 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="输出路径:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.RenderOutputPath}"
                                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding Properties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.RenderOutputPath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>
                        
                        <!-- Frame Path -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="真实帧路径:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.FramePath}"
                                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding Properties.FramePath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.FramePath, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>
                        
                        <!-- 输出格式 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="输出格式:" FontWeight="SemiBold" MinWidth="80" />
                            <TextBlock Grid.Column="1" Text="{Binding Properties.RenderOutputFormat}"
                                       IsVisible="{Binding Properties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="1" Text="未设置" Foreground="#666"
                                       IsVisible="{Binding Properties.RenderOutputFormat, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 空状态 -->
                <Border CornerRadius="4" Padding="20" IsVisible="{Binding !Properties.IsLoaded}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="文件未加载" HorizontalAlignment="Center"
                                   Foreground="#666" FontStyle="Italic" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>