<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:BlenderRenderQueue.ViewModels.DesignTime"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:animations="clr-namespace:SukiUI.Animations;assembly=SukiUI"
             xmlns:i18n="clr-namespace:BlenderRenderQueue.Localizer"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="BlenderRenderQueue.Views.RenderQueueButtonsView"
             x:DataType="viewModels:RenderQueueViewModel">

    <Design.DataContext>
        <design:DesignTimeRenderQueueViewModel />
    </Design.DataContext>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="*,*" HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <!-- Start queue button: Not visible when there are no tasks, visible when there are tasks but determined by the number of available tasks -->
        <Button Classes="Accent Flat Rounded" Command="{Binding StartQueueCommand}"
                IsVisible="{Binding CanShowStartQueue}"
                IsEnabled="{Binding CanStartQueue}" Margin="4 0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="BlenderSoftware" Width="24" Height="24" />
                <TextBlock Text="{i18n:Localize Queue_StartQueue}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Pause queue button: Appears only when the queue is running-->
        <Button Grid.Row="0" Grid.Column="0" Classes="Warning Rounded" Command="{Binding PauseQueueCommand}"
                IsVisible="{Binding CanPauseQueue}" Margin="4 0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="Pause" Width="24" Height="24" />
            </StackPanel>
        </Button>

        <!-- Resume queue button: Appears only when the queue is paused-->
        <Button Grid.Row="0" Grid.Column="0" Classes="Success Rounded" Command="{Binding ResumeQueueCommand}"
                IsVisible="{Binding CanResumeQueue}" Margin="4 0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="Play" Width="24" Height="24" />
                <TextBlock Text="{i18n:Localize Queue_ResumeQueue}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Stop Queue Button: Appears only when the queue is running -->
        <Button Grid.Row="0" Grid.Column="1" Classes="Danger Rounded" Command="{Binding StopQueueCommand}"
                IsVisible="{Binding CanStopQueue}" Margin="4 0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="Stop" Width="24" Height="24" />
            </StackPanel>
        </Button>

        <Button Grid.Row="0" Grid.Column="2" Command="{Binding AddMultipleTasksCommand}"
                Classes="Flat Rounded" Margin="4 0" >
            <StackPanel Orientation="Horizontal" Spacing="4">
                <material:MaterialIcon Kind="AddBold" Width="24" Height="24" />
                <TextBlock Text="{i18n:Localize Queue_AddTasks}" VerticalAlignment="Center"
                           IsVisible="{Binding HasNoTasks}" />
            </StackPanel>
        </Button>
        <!-- Generate Video Button: Disable when pressed, showing a progress bar -->
        <Button Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="0" Classes="Rounded" Margin="4 8"
                Command="{Binding GenerateVideoFromSelectedTaskCommand}"
                suki:ButtonExtensions.ShowProgress="{Binding IsGeneratingVideo}"
                ToolTip.Tip="为选中的任务生成 H.265 视频（需要设置有效的 FFmpeg 路径和帧路径目录中有图片文件）">
            <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="SelectedTask"
                             Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                    <Binding Path="!IsGeneratingVideo" />
                </MultiBinding>
            </Button.IsEnabled>
            <Button.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🎬" VerticalAlignment="Center" />
                    <TextBlock Text="{i18n:Localize Queue_GenerateVideo}" VerticalAlignment="Center" />
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
    </StackPanel>

</UserControl>