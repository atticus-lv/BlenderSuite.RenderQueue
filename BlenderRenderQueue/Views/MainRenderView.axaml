<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BlenderRenderQueue.ViewModels"
             xmlns:views="clr-namespace:BlenderRenderQueue.Views"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:services1="clr-namespace:BlenderRenderQueue.Services"
             xmlns:controls="clr-namespace:BlenderRenderQueue.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="BlenderRenderQueue.Views.MainRenderView"
             x:DataType="vm:MainRenderViewModel"
             services1:ToplevelService.Register="{Binding}">

    <Grid RowDefinitions="*,Auto" Margin="0 4 0 0">

        <!-- Blender验证失败时的覆盖层 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SukiOverlayColor}" 
                IsVisible="{Binding HasBlenderValidationError}"
                ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="16">
                <avalonia:MaterialIcon Kind="Error" 
                                       Width="64" 
                                       Height="64" 
                                       Foreground="{DynamicResource SukiDangerColor}" />
                <TextBlock Text="Blender验证失败" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource SukiTextColor}" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BlenderValidationMessage}" 
                           FontSize="16" 
                           Foreground="{DynamicResource SukiTextSecondaryColor}" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" />
                <Button Content="打开设置" 
                        Command="{Binding OpenSettingsCommand}"
                        Classes="Primary"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 渲染队列视图 -->
        <views:RenderQueueView Grid.Row="0" 
                               DataContext="{Binding RenderQueue}" 
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch"
                               IsEnabled="{Binding $parent[UserControl].((vm:MainRenderViewModel)DataContext).IsBlenderPathValid}" />

        <!-- 底部日志区域 -->
        <Border Grid.Row="1" Margin="4 0 4 8" 
                Background="{DynamicResource SukiBackgroundColor}" >
            <TextBox Text="{Binding StatusMessage}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" 
                     Background="Transparent" 
                     BorderThickness="0" />
        </Border>

    </Grid>

</UserControl>