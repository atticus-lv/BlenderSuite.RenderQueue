<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlenderRenderQueue.App"
             xmlns:local="using:BlenderRenderQueue"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:localizer="clr-namespace:BlenderRenderQueue.Localizer"
             xmlns:converters="clr-namespace:BlenderRenderQueue.Converters"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <converters:FileNameConverter x:Key="FileNameConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:ObjectEqualMultiConverter x:Key="ObjectEqualMultiConverter" />
            <converters:StatusToIconVisibilityConverter x:Key="StatusToIconVisibilityConverter" />
            <localizer:LocalizeConverter x:Key="LocalizeConverter" />
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" Locale="zh-CN" />
        <material:MaterialIconStyles />
    </Application.Styles>

</Application>